# Physical-platform electrical layout for SITL: two DJI BPX230-6768-22.14
# 6768 mAh Li-ion 6S packs in parallel. Voltage remains 6S and capacity adds
# to 13536 mAh. Full voltage is 25.5 V (4.25 V/cell). These values
# come from the intended aircraft; do not import temporary test-battery values
# from the real PX4 snapshot. ESC current is not load-coupled in SITL.
param set-default BAT1_N_CELLS 6
param set-default BAT1_CAPACITY 13536
param set-default BAT1_V_CHARGED 4.25
# MPC_THR_HOVER depends on the simulated thrust curve rather than the flight
# controller alone. 6 kg * g balanced by the provisional U7/P15x5 curves gives
# 0.5686, so keep this parameter outside the verbatim real-PX4 migration block.
param set-default MPC_THR_HOVER 0.57

# External vision contributes XY only. GPS is disabled.
param set-default EKF2_EV_DELAY 5
param set-default EKF2_EV_CTRL 1
param set-default EKF2_GPS_CTRL 0

# Baseline A/B uses barometer only as PX4's internal vertical reference.
# The Task 2 depth estimate remains side optical-flow integration.
param set-default EKF2_HGT_REF 0
param set-default EKF2_BARO_CTRL 1
