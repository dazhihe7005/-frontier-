#!/bin/sh
# SITL-only shaft airframe: external vision horizontal position only.
# Vertical position is deliberately NOT fused from external vision.

. ${R}etc/init.d-posix/airframes/10015_gazebo-classic_iris

# STEP-derived X geometry. PX4 uses FRD body axes, whereas the Gazebo model
# uses FLU, so the SDF Y coordinates are negated here. Keeping the stock Iris
# allocation would command the symmetric 620.843 mm platform as an asymmetric
# frame and introduce roll/pitch moments during collective-thrust changes.
# CA_ROTOR*_KM must also match the Gazebo motor plugin's provisional
# momentConstant.  Leaving the stock Iris value (0.05) while Gazebo uses
# 0.007899 makes PX4 overestimate yaw authority by 6.3x and allows yaw loss.
param set-default CA_ROTOR0_PX 0.219501
param set-default CA_ROTOR0_PY 0.219501
param set-default CA_ROTOR0_KM 0.00789903182
param set-default CA_ROTOR1_PX -0.219501
param set-default CA_ROTOR1_PY -0.219501
param set-default CA_ROTOR1_KM 0.00789903182
param set-default CA_ROTOR2_PX 0.219501
param set-default CA_ROTOR2_PY -0.219501
param set-default CA_ROTOR2_KM -0.00789903182
param set-default CA_ROTOR3_PX -0.219501
param set-default CA_ROTOR3_PY 0.219501
param set-default CA_ROTOR3_KM -0.00789903182

# Compatible controller, limit and filter values from the read-only real-PX4
