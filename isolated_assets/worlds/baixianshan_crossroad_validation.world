<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Validation-only registration of the unchanged 1:1 Baixiangshan mesh.
       A 180-degree rotation about the standard spawn (-7, 0.2) preserves the
       known-stable takeoff surface while putting the real branch junction in
       front of the vehicle.  Vehicle yaw, altitude and mesh scale are not
       changed.  For a half-turn around (-7, 0.2), the mesh translation must
       be twice that pivot: (-14, 0.4). -->
  <world name="baixianshan_crossroad_validation">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode><solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver></ode>
    </physics>
    <scene>
      <ambient>0.30 0.31 0.32 1</ambient>
      <background>0.012 0.015 0.018 1</background>
      <shadows>false</shadows>
    </scene>
    <include>
      <uri>model://baixianshan_tunnel</uri>
      <pose>-14 0.4 0 0 0 3.141592654</pose>
    </include>
    <!-- Match the production world's deterministic takeoff contact.  The
         rotated survey mesh otherwise leaves one landing rail on rough rock,
         which can fail PX4's roll pre-arm check before planning begins. -->
    <model name="gbplanner_launch_pad">
      <static>true</static>
      <pose>-7.0 0.2 0.15 0 0 0</pose>
      <link name="pad">
        <collision name="collision">
          <geometry><box><size>0.65 0.55 0.10</size></box></geometry>
          <surface>
            <contact><ode><kp>1000000</kp><kd>10000</kd><max_vel>0.05</max_vel><min_depth>0.001</min_depth></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.55 0.10</size></box></geometry>
          <material><ambient>0.22 0.23 0.24 1</ambient><diffuse>0.30 0.31 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>
    <light name="junction" type="point">
      <pose>13 2.4 5 0 0 0</pose>
      <diffuse>0.65 0.67 0.70 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
      <attenuation><range>35</range><constant>0.5</constant><linear>0.035</linear><quadratic>0.004</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
  </world>
</sdf>
