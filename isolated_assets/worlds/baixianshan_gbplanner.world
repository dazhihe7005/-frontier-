<?xml version="1.0"?>
<sdf version="1.6">
  <!-- Isolated GBPlanner2 world.  The Baixiangshan survey mesh remains at
       its original 1:1 scale and registration.  The small flat launch pad
       only replaces the rough contact patch beneath the initial vehicle
       pose; it does not change the tunnel or its collision geometry. -->
  <world name="baixianshan_gbplanner">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode><solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver></ode>
    </physics>

    <scene>
      <ambient>0.30 0.31 0.32 1</ambient>
      <background>0.012 0.015 0.018 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="baixianshan_spawn_view">
        <pose>-5.5 -5.0 3.2 0 0.18 0.55</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <include><uri>model://baixianshan_tunnel</uri></include>

    <!-- Flat 0.65 x 0.55 m takeoff patch matching the STEP landing-rail
         footprint.  It is wholly inside the MID360 body/self-return filter,
         so it stabilizes physical contact without entering the exploration
         map. -->
    <model name="gbplanner_launch_pad">
      <static>true</static>
      <!-- Top surface z=0.20 m, clear of the surveyed rough floor. -->
      <pose>-7.0 0.2 0.15 0 0 0</pose>
      <link name="pad">
        <collision name="collision">
          <geometry><box><size>0.65 0.55 0.10</size></box></geometry>
          <surface>
            <contact><ode><kp>1000000</kp><kd>10000</kd><max_vel>0.05</max_vel><min_depth>0.001</min_depth></ode></contact>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.55 0.10</size></box></geometry>
          <material>
            <ambient>0.22 0.23 0.24 1</ambient>
            <diffuse>0.30 0.31 0.32 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="lamp_spawn" type="point"><pose>0 0 3.5 0 0 0</pose><diffuse>0.70 0.72 0.75 1</diffuse><specular>0.02 0.02 0.02 1</specular><attenuation><range>45</range><constant>0.45</constant><linear>0.030</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light name="lamp_forward_1" type="point"><pose>35 2 5 0 0 0</pose><diffuse>0.62 0.64 0.67 1</diffuse><specular>0.02 0.02 0.02 1</specular><attenuation><range>40</range><constant>0.5</constant><linear>0.035</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light name="lamp_forward_2" type="point"><pose>75 4 7 0 0 0</pose><diffuse>0.62 0.64 0.67 1</diffuse><specular>0.02 0.02 0.02 1</specular><attenuation><range>40</range><constant>0.5</constant><linear>0.035</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
    <light name="lamp_forward_3" type="point"><pose>115 6 6 0 0 0</pose><diffuse>0.62 0.64 0.67 1</diffuse><specular>0.02 0.02 0.02 1</specular><attenuation><range>40</range><constant>0.5</constant><linear>0.035</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
  </world>
</sdf>
