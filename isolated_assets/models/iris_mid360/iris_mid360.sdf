<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iris_mid360">
    <include>
      <uri>model://mine_uav_800_no_gps</uri>
      <name>iris</name>
    </include>

    <link name="mid360_link">
      <!-- FLU: 131.5 mm forward, 173 mm above the 50 mm body-top
           reference, pitched 25 deg toward -Z. -->
      <pose>0.1315 0 0.223 0 0.436332313 0</pose>
      <inertial>
        <!-- Livox MID360S mass used by the canonical vehicle: 265 g. -->
        <mass>0.265</mass>
        <inertia>
          <ixx>1.50e-4</ixx>
          <iyy>1.50e-4</iyy>
          <izz>1.40e-4</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.0325</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.0325</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- MID360S coverage for algorithm testing.  The native vertical FOV
           is asymmetric: -7 deg below to +52 deg above the sensor's local
           horizontal plane.  With the housing pitched +25 deg about body Y
           (toward body -Z), this becomes -32..+27 deg in the body frame.
           This is a Gazebo ray approximation, not a Livox packet/timing
           simulator. -->
      <sensor name="mid360_ray" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173048</min_angle>
              <max_angle>0.907571211</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>30.0</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="mid360_ros" filename="libgazebo_ros_block_laser.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>10</updateRate>
          <topicName>/mine_uav/sitl/mid360/points</topicName>
          <frameName>mid360_link</frameName>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
      <!-- Simulation-only downward range guard. The STEP landing rails end
           at body z=-0.272 m; the old ray started at the body origin and
           returned its own landing gear at 0.238 m. Start 0.350 m below the
           body origin, clear of the rails, and add 0.350 m at the consumer
           to recover body-origin floor clearance. A single central beam
           missed the sloped floor 0.41 m to the side at x=79.5 m. Use a
           45-degree 2-D fan around body -Z; gazebo_ros_range publishes the
           minimum of these rays. This is still extra simulation hardware,
           not a physical MID360S capability. -->
      <sensor name="shaft_downward_ray" type="ray">
        <pose>0.122980734 0 -0.574888632 0 1.134464014 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>11</samples><resolution>1</resolution>
              <min_angle>-0.785398163</min_angle><max_angle>0.785398163</max_angle>
            </horizontal>
            <vertical>
              <samples>11</samples><resolution>1</resolution>
              <min_angle>-0.785398163</min_angle><max_angle>0.785398163</max_angle>
            </vertical>
          </scan>
          <range><min>0.2</min><max>30.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="shaft_downward_ros" filename="libgazebo_ros_range.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn><updateRate>20</updateRate>
          <topicName>/mine_uav/sitl/shaft_downward_range</topicName>
          <frameName>shaft_downward_range</frameName>
          <fov>1.570796327</fov><radiation>infrared</radiation>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </link>

    <joint name="mid360_joint" type="fixed">
      <parent>iris::base_link</parent>
      <child>mid360_link</child>
    </joint>
  </model>
</sdf>
