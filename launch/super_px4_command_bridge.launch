<launch>
  <arg name="config" default="$(find mine_uav_control)/config/super_px4_command_bridge.yaml"/>
  <arg name="offboard_rate" default="50.0"/>
  <arg name="fallback_mode" default="POSCTL"/>
  <arg name="max_speed" default="1.1"/>
  <arg name="max_horizontal_radius" default="40.0"/>
  <arg name="min_height" default="-0.5"/>
  <arg name="max_height" default="1.8"/>
  <arg name="height_clamp_tolerance" default="0.25"/>

  <node pkg="mine_uav_control" type="super_px4_command_bridge"
        name="super_px4_command_bridge" output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="fallback_mode" value="$(arg fallback_mode)"/>
    <param name="max_speed" value="$(arg max_speed)"/>
    <param name="max_horizontal_radius" value="$(arg max_horizontal_radius)"/>
    <param name="min_height" value="$(arg min_height)"/>
    <param name="max_height" value="$(arg max_height)"/>
    <param name="height_clamp_tolerance" value="$(arg height_clamp_tolerance)"/>
  </node>

  <!-- This node only repeats a fresh validated target. The command bridge may
       request OFFBOARD/POSCTL, but neither node ever arms PX4. -->
  <node pkg="mine_uav_control" type="offboard_bridge"
        name="offboard_bridge" output="screen" required="true">
    <param name="rate" value="$(arg offboard_rate)"/>
  </node>
</launch>
