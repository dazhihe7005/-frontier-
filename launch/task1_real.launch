<launch>
  <!-- Load the Fast-LIO2 workspace first, then load the SUPER workspace while
       preserving the first overlay before running this launch file. -->
  <arg name="start_livox" default="true"/>
  <arg name="start_fastlio" default="true"/>
  <arg name="start_mavros" default="true"/>
  <arg name="start_super" default="true"/>
  <arg name="rviz" default="false"/>

  <!-- A stale SITL /use_sim_time without /clock freezes freshness timers.
       Exit the complete real-aircraft launch instead of silently proceeding. -->
  <node pkg="mine_uav_control" type="task1_real_time_guard.py"
        name="task1_real_time_guard" output="screen" required="true"/>

  <group if="$(arg start_livox)">
    <!-- The connected unit reports Livox device type 35 (Mid360s), not type 9 (MID360). -->
    <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360s.launch"/>
  </group>

  <group if="$(arg start_fastlio)">
    <include file="$(find fast_lio)/launch/mapping_mid360.launch">
      <arg name="rviz" value="$(arg rviz)"/>
    </include>
  </group>

  <group if="$(arg start_mavros)">
    <include file="$(find mine_uav_control)/launch/px4_serial.launch"/>
  </group>

  <include file="$(find mine_uav_control)/launch/fastlio_px4_vision_bridge.launch"/>
  <include file="$(find mine_uav_control)/launch/mission_scheduler.launch"/>

  <!-- Raw Fast-LIO2 remains available to PX4 localization at all times. Only
       task-gated samples enter the decision/planning map, so ground takeoff
       returns cannot contaminate a new exploration mission. -->
  <node pkg="mine_uav_control" type="task1_perception_gate"
        name="task1_perception_gate" output="screen" required="true"/>

  <include file="$(find mine_uav_control)/launch/super_exploration_decider.launch">
    <!-- Laboratory procedure: manual hover first, then a CH7 edge starts
         a fresh task and captures home from the synchronized pose. -->
    <arg name="require_mission_enable_edge" value="true"/>
  </include>

  <group if="$(arg start_super)">
    <node pkg="super_planner" type="fsm_node" name="fsm_node"
          output="screen" required="true">
      <param name="config_path"
             value="$(find mine_uav_control)/config/super_task1.yaml"/>
    </node>
  </group>

  <include file="$(find mine_uav_control)/launch/super_px4_command_bridge.launch"/>
</launch>
