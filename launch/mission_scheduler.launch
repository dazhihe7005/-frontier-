<launch>
  <arg name="config" default="$(find mine_uav_control)/config/mission_scheduler.yaml" />

  <node pkg="mine_uav_control"
        type="mission_scheduler"
        name="mission_scheduler"
        output="screen"
        required="true">
    <rosparam command="load" file="$(arg config)" />
  </node>
</launch>
