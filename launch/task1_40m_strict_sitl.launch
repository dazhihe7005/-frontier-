<launch>
  <!-- Isolated Task1 clearance regression; never use this launch for a real aircraft. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <include file="$(find mine_uav_control)/launch/task1_40m_platform_sitl.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="super_config_path"
         value="$(find mine_uav_control)/config/super_task1_strict_clearance_probe.yaml"/>
    <arg name="decider_vehicle_radius" value="1.8"/>
    <arg name="decider_vertical_vehicle_radius" value="0.4"/>
    <arg name="forward_corridor_half_width" value="2.0"/>
    <arg name="max_task_lateral_offset" value="4.0"/>
  </include>
</launch>
