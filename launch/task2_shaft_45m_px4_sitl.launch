<launch>
  <!-- Bind the 45 m geometry and the truth-range geometry constant together.
       PX4 connection remains the isolated UDP SITL URL in the included file. -->
  <arg name="gui" default="false"/>
  <arg name="rviz" default="false"/>
  <include file="$(find mine_uav_control)/launch/task2_shaft_22m_px4_sitl.launch">
    <arg name="world" value="$(find mine_uav_control)/worlds/shaft_45m_logic_sitl.world"/>
    <arg name="bottom_top_world_z" value="-44.85"/>
    <arg name="entrance_world_z" value="0.25"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
