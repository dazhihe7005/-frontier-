<launch>
  <!-- Canonical Task-4 entry. Keep the old Task-1-named wrapper callable so
       existing test commands and field notes do not break. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="allow_auto_arm" default="true"/>
  <arg name="auto_enable_delay" default="10.0"/>
  <arg name="takeoff_height" default="1.5"/>

  <include file="$(find mine_uav_control)/launch/task1_baixiangshan_px4_sitl.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="allow_auto_arm" value="$(arg allow_auto_arm)"/>
    <arg name="auto_enable_delay" value="$(arg auto_enable_delay)"/>
    <arg name="takeoff_height" value="$(arg takeoff_height)"/>
  </include>
</launch>
