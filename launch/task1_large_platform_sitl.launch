<launch>
  <!-- Large-scale task-one demonstration. The mine entrance is open at x=0;
       the vehicle starts outside on a platform whose top is at world z=15 m.
       Planner coordinates remain local to the PX4/Fast-LIO2 takeoff origin. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="allow_auto_arm" default="true"/>

  <include file="$(find mine_uav_control)/launch/task1_px4_sitl.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="allow_auto_arm" value="$(arg allow_auto_arm)"/>
    <arg name="world"
         value="$(find mine_uav_control)/worlds/goaf_large_platform.world"/>
    <arg name="vehicle_sdf"
         value="$(find mine_uav_control)/models/iris_mid360_long_range/iris_mid360_long_range.sdf"/>
    <arg name="spawn_x" value="-8.0"/>
    <arg name="spawn_y" value="0.0"/>
    <arg name="spawn_z" value="16.15"/>
    <arg name="spawn_yaw" value="0.0"/>

    <!-- The far wall is 158 m from the takeoff point. -->
    <arg name="max_exploration_radius" value="170.0"/>
    <arg name="frontier_search_radius" value="30.0"/>
    <arg name="decider_max_map_radius" value="180.0"/>
    <arg name="decider_raycast_max_range" value="69.5"/>
    <arg name="decider_sync_slop" value="0.15"/>
    <arg name="decider_data_timeout" value="3.0"/>
    <arg name="decider_max_points_per_cloud" value="1600"/>
    <arg name="side_wall_max_range" value="60.0"/>
    <arg name="wall_coverage_side_max_distance" value="55.0"/>
    <arg name="wall_coverage_end_min_span" value="80.0"/>
    <arg name="lidar_max_range" value="69.5"/>

    <!-- These bounds are in the local takeoff frame, not world altitude. -->
    <arg name="bridge_max_horizontal_radius" value="175.0"/>
    <arg name="bridge_min_height" value="-2.0"/>
    <arg name="bridge_max_height" value="5.0"/>
  </include>
</launch>
