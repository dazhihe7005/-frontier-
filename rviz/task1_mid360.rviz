Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Registered MID3601
        - /Accumulated Map1
      Splitter Ratio: 0.50
    Tree Height: 520
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.50
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz/Grid
      Color: 110; 110; 110
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0.4
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 80; 40
      Min Color: 40; 100; 255
      Name: Registered MID360
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.035
      Style: Points
      Topic: /cloud_registered
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.65
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 190; 190; 190
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Accumulated Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.025
      Style: Points
      Topic: /Laser_map
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Buffer Length: 5000
      Class: rviz/Path
      Color: 0; 255; 80
      Enabled: true
      Head Diameter: 0.25
      Head Length: 0.20
      Length: 0.30
      Line Style: Lines
      Line Width: 0.04
      Name: FAST-LIO2 Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 80; 0
      Pose Style: None
      Radius: 0.04
      Shaft Diameter: 0.08
      Shaft Length: 0.10
      Topic: /path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /mine_uav/exploration/frontiers
      Name: Exploration Frontiers
      Namespaces: {}
      Queue Size: 20
      Value: true
  Enabled: true
  Global Options:
    Background Color: 28; 32; 38
    Default Light: true
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -1.45
      Class: rviz/Orbit
      Distance: 35
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 10
        Y: 0
        Z: 1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.25
      Target Frame: camera_init
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 000000ff00000000fd0000000100000000000001900000034efc0200000002fb000000100044006900730070006c006100790073010000003d0000025b000000c900fffffffb0000000a00560069006500770073010000029e000000ed000000a000ffffff000005460000034e00000004000000040000000800000008fc00000000
  Views:
    collapsed: false
  Width: 1366
  X: 40
  Y: 30
