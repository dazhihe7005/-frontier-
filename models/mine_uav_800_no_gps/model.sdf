<!-- Canonical shared Task 1 / Task 2 vehicle model. -->
<sdf version='1.6'>
  <model name='mine_uav_800_no_gps'>
    <!--
      Physical-platform approximation shared by all SITL tasks.
      - STEP-authoritative 620.843 mm diagonal motor-to-motor wheelbase
        (439.002 mm adjacent spacing). The earlier 800 mm value describes the
        reported frame class, not the motor-centre diagonal in this assembly.
      - FLU body frame: +X forward, +Y left, +Z up.
      - 6.000 kg total when included by the 0.265 kg MID360S wrapper.
      - Two 6768 mAh DJI BPX230 Li-ion 6S packs in parallel: 22.14 V
        nominal, 13536 mAh and 299.8 Wh total; battery mass is 1.280 kg.
      - LANRC BLHeli_S DSHOT600 4-in-1 ESC,
        60 A continuous per channel. Gazebo Classic does not electrically
        couple ESC current, battery energy and propeller load.
      - T-Motor U7 KV420, 33 mOhm, 40 A maximum, 350 W maximum
        continuous power, with P15x5 carbon propellers.
      - The provisional thrust curve anchors the user's 4.64 kgf maximum
        thrust at the 6S no-load ceiling (9298.8 rpm). It must be replaced when
        a measured P15x5 thrust/RPM/current table is available.
    -->
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>4.536</mass>
        <inertia>
          <!-- 4.536 kg lump: 3.256 kg body/frame/avionics plus two 0.640 kg
               battery packs. Approximate inertia. The four
               0.296 kg motors are separately positioned rotor links. -->
          <ixx>0.124</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.124</iyy>
          <iyz>0</iyz>
          <izz>0.228</izz>
        </inertia>
      </inertial>
      <!-- Collision remains a deterministic simplified hull. The detailed
           STEP-derived mesh is visual-only so ray/contact physics stay stable. -->
      <collision name='centre_body_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.325 0.307 0.10</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='front_right_arm_collision'>
        <pose>0.109751 -0.109751 0.015 0 0 -0.78539816339</pose>
        <geometry><box><size>0.31 0.035 0.025</size></box></geometry>
      </collision>
      <collision name='back_left_arm_collision'>
        <pose>-0.109751 0.109751 0.015 0 0 2.35619449019</pose>
        <geometry><box><size>0.31 0.035 0.025</size></box></geometry>
      </collision>
      <collision name='front_left_arm_collision'>
        <pose>0.109751 0.109751 0.015 0 0 0.78539816339</pose>
        <geometry><box><size>0.31 0.035 0.025</size></box></geometry>
      </collision>
      <collision name='back_right_arm_collision'>
        <pose>-0.109751 -0.109751 0.015 0 0 -2.35619449019</pose>
        <geometry><box><size>0.31 0.035 0.025</size></box></geometry>
      </collision>
      <visual name='step_body_visual'>
        <!-- STEP millimetres -> metres, native [X,Y,Z] -> FLU [X,-Z,Y].
             The translation places the four motor-centre mean at the body
             origin horizontally and at z=0.035 m vertically. -->
        <pose>0.010174 1.1 0.044978 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mine_uav_800_no_gps/meshes/uav_body_step_visual.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>
    <link name='/imu_link'>
      <pose>0 0 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='/imu_joint' type='revolute'>
      <child>/imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name='rotor_0'>
      <pose>0.219501 -0.219501 0.035 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.296</mass>
        <inertia>
