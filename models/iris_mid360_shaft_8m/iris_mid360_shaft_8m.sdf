<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iris_mid360_shaft_8m">
    <include>
      <uri>model://iris</uri>
      <name>iris</name>
    </include>

    <link name="mid360_link">
      <pose>0 0 0.14 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>1.0e-5</ixx>
          <iyy>1.0e-5</iyy>
          <izz>1.0e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- MID360-like coverage for algorithm testing. This is a Gazebo ray
           approximation, not a Livox packet/timing simulator. -->
      <sensor name="mid360_ray" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.785398</min_angle>
              <max_angle>0.785398</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>30.0</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="mid360_ros" filename="libgazebo_ros_block_laser.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>10</updateRate>
          <topicName>/mine_uav/sitl/mid360/points</topicName>
          <frameName>mid360_link</frameName>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
      <!-- Downward single-beam range for shaft SITL. Gazebo ray axis is +X;
           +90 deg pitch points it toward -Z. Offset cancels this link's
           +0.14 m mounting height so measurements start at the base origin. -->
      <sensor name="shaft_downward_ray" type="ray">
        <pose>0 0 -0.14 0 1.57079632679 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <ray>
          <scan><horizontal>
            <samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal></scan>
          <range><min>0.3</min><max>8.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="shaft_downward_ros" filename="libgazebo_ros_range.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn><updateRate>20</updateRate>
          <topicName>/mine_uav/sitl/shaft_downward_range</topicName>
          <frameName>shaft_downward_range</frameName>
          <fov>0.01</fov><radiation>infrared</radiation>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </link>

    <joint name="mid360_joint" type="fixed">
      <parent>iris::base_link</parent>
      <child>mid360_link</child>
    </joint>
  </model>
</sdf>
