<?xml version="1.0"?>
<sdf version="1.6">
  <model name="baixianshan_tunnel">
    <static>true</static>
    <link name="survey_tunnel">
      <visual name="rock_visual">
        <cast_shadows>true</cast_shadows>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_rock.obj</uri></mesh></geometry>
      </visual>
      <collision name="rock_collision">
        <max_contacts>1</max_contacts>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_rock.obj</uri></mesh></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="ground_visual">
        <cast_shadows>true</cast_shadows>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_ground.obj</uri></mesh></geometry>
      </visual>
      <collision name="ground_collision">
        <max_contacts>1</max_contacts>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_ground.obj</uri></mesh></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>

      <visual name="roof_visual">
        <cast_shadows>true</cast_shadows>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_roof.obj</uri></mesh></geometry>
      </visual>
      <collision name="roof_collision">
        <max_contacts>1</max_contacts>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_roof.obj</uri></mesh></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>

      <visual name="infrastructure_visual">
        <cast_shadows>true</cast_shadows>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_infrastructure.obj</uri></mesh></geometry>
      </visual>
      <collision name="infrastructure_collision">
        <max_contacts>1</max_contacts>
        <geometry><mesh><uri>model://baixianshan_tunnel/meshes/baixianshan_infrastructure.obj</uri></mesh></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
</sdf>
