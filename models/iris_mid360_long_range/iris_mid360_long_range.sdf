<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iris_mid360_long_range">
    <include>
      <uri>model://iris</uri>
      <name>iris</name>
    </include>

    <link name="mid360_link">
      <!-- Mount above the simulated Iris rotor disk. At 0.14 m, the lower
           five scan rings strike the vehicle at 0.24 to 0.31 m and never see
           the chamber floor/lower walls. This is a SITL mounting fixture,
           not a real MID360 extrinsic calibration. -->
      <pose>0 0 0.60 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>1.0e-5</ixx>
          <iyy>1.0e-5</iyy>
          <izz>1.0e-5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.04</length></cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.04</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Idealized long-range scan for the 100 m wide chamber test. It keeps
           the current algorithm and topic contract, but is not a Livox packet
           or reflectivity simulation. -->
      <sensor name="mid360_long_range_ray" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>240</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.785398</min_angle>
              <max_angle>0.785398</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.20</min>
            <max>70.0</max>
            <resolution>0.03</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <plugin name="mid360_long_range_ros" filename="libgazebo_ros_block_laser.so">
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>10</updateRate>
          <topicName>/mine_uav/sitl/mid360/points</topicName>
          <frameName>mid360_link</frameName>
          <gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
    </link>

    <joint name="mid360_joint" type="fixed">
      <parent>iris::base_link</parent>
      <child>mid360_link</child>
    </joint>
  </model>
</sdf>
