<?xml version="1.0"?>
<sdf version="1.6">
  <world name="baixianshan_tunnel_sitl">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode><solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver></ode>
    </physics>

    <scene>
      <ambient>0.30 0.31 0.32 1</ambient>
      <background>0.012 0.015 0.018 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="baixianshan_spawn_view">
        <pose>-11.0 -10.0 6.4 0 0.18 0.55</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <include><uri>model://baixianshan_tunnel</uri></include>

    <!-- Sparse, shadow-free equivalents of the source scene's tunnel lamps.
         They affect Gazebo visualization only; MID360 rays use collision. -->
    <light name="lamp_south_120" type="point"><pose>-240 52 7.2 0 0 0</pose><diffuse>0.65 0.67 0.70 1</diffuse><specular>0.02 0.02 0.02 1</specular><attenuation><range>60</range><constant>0.5</constant><linear>0.0175</linear><quadratic>0.001</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
