<?xml version="1.0"?>
<sdf version="1.6">
  <world name="goaf_serpentine_maze">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.06 0.07 0.08 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="overview">
        <pose>-22 -42 39 0 0.48 0.82</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- The platform top is at the chamber's middle height, z=15 m. Its
         front edge meets the open entrance plane x=0. -->
    <model name="entrance_platform">
      <static>true</static>
      <pose>-8 0 14.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 14 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 14 1</size></box></geometry>
          <material>
            <ambient>0.22 0.24 0.28 1</ambient>
            <diffuse>0.32 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Open entrance at x=0. Clear internal dimensions are 40 m deep (x),
         40 m wide (y), and 30 m high (z). Three full-height baffles alternate side openings. -->
    <model name="left_wall">
      <static>true</static>
      <pose>20 20 15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.4 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.4 30</size></box></geometry>
          <material>
            <ambient>0.30 0.25 0.20 1</ambient>
            <diffuse>0.42 0.35 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_wall">
      <static>true</static>
      <pose>20 -20 15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 0.4 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 0.4 30</size></box></geometry>
          <material>
            <ambient>0.30 0.25 0.20 1</ambient>
            <diffuse>0.42 0.35 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="far_wall">
      <static>true</static>
      <pose>40 0 15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 40 30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 40 30</size></box></geometry>
          <material>
            <ambient>0.34 0.27 0.20 1</ambient>
            <diffuse>0.48 0.38 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="ceiling">
      <static>true</static>
      <pose>20 0 30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 40 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 40 0.4</size></box></geometry>
          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.28 0.28 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="chamber_floor">
      <static>true</static>
      <pose>20 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 40 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 40 0.2</size></box></geometry>
          <material>
            <ambient>0.18 0.16 0.14 1</ambient>
            <diffuse>0.26 0.23 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Alternating 14 m side openings. Each partition reaches the floor and
         ceiling, so the vehicle must traverse laterally rather than fly over. -->
    <model name="baffle_1_right_opening">
      <static>true</static>
      <pose>10 -7 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 26 30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 26 30</size></box></geometry></visual>
      </link>
    </model>
    <model name="baffle_2_left_opening">
      <static>true</static>
      <pose>20 7 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 26 30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 26 30</size></box></geometry></visual>
      </link>
    </model>
    <model name="baffle_3_right_opening">
      <static>true</static>
      <pose>30 -7 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 26 30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 26 30</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
