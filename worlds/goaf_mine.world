<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="goaf_mine">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Open entrance at x=-2; side walls and far wall form the three
         continuous surfaces used by the task-one completion strategy. -->
    <model name="left_wall">
      <static>true</static>
      <pose>10 4 2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>24 0.2 4</size></box></geometry></collision><visual name="visual"><geometry><box><size>24 0.2 4</size></box></geometry></visual></link>
    </model>
    <model name="right_wall">
      <static>true</static>
      <pose>10 -4 2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>24 0.2 4</size></box></geometry></collision><visual name="visual"><geometry><box><size>24 0.2 4</size></box></geometry></visual></link>
    </model>
    <model name="far_wall">
      <static>true</static>
      <pose>22 0 2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 8 4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8 4</size></box></geometry></visual></link>
    </model>
    <model name="ceiling">
      <static>true</static>
      <pose>10 0 4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>24 8 0.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>24 8 0.2</size></box></geometry></visual></link>
    </model>
  </world>
</sdf>
