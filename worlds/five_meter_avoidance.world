<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="five_meter_avoidance">
    <include><uri>model://sun</uri></include>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.04 0.04 0.05 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="five_meter_overview">
        <pose>-4 -8 7 0 0.45 0.75</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- A 14 m x 10 m closed room gives Fast-LIO2 non-degenerate returns. -->
    <model name="test_room">
      <static>true</static>
      <link name="room">
        <collision name="floor_collision">
          <pose>4 0 -0.10 0 0 0</pose>
          <geometry><box><size>14 10 0.20</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>4 0 -0.10 0 0 0</pose>
          <geometry><box><size>14 10 0.20</size></box></geometry>
          <material><ambient>0.24 0.24 0.25 1</ambient><diffuse>0.34 0.34 0.35 1</diffuse></material>
        </visual>

        <collision name="left_wall_collision">
          <pose>4 5 2.25 0 0 0</pose>
          <geometry><box><size>14 0.20 4.5</size></box></geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>4 5 2.25 0 0 0</pose>
          <geometry><box><size>14 0.20 4.5</size></box></geometry>
          <material><ambient>0.30 0.28 0.25 1</ambient><diffuse>0.42 0.39 0.34 1</diffuse></material>
        </visual>

        <collision name="right_wall_collision">
          <pose>4 -5 2.25 0 0 0</pose>
          <geometry><box><size>14 0.20 4.5</size></box></geometry>
        </collision>
        <visual name="right_wall_visual">
          <pose>4 -5 2.25 0 0 0</pose>
          <geometry><box><size>14 0.20 4.5</size></box></geometry>
          <material><ambient>0.30 0.28 0.25 1</ambient><diffuse>0.42 0.39 0.34 1</diffuse></material>
        </visual>

        <collision name="rear_wall_collision">
          <pose>-3 0 2.25 0 0 0</pose>
          <geometry><box><size>0.20 10 4.5</size></box></geometry>
        </collision>
        <visual name="rear_wall_visual">
          <pose>-3 0 2.25 0 0 0</pose>
          <geometry><box><size>0.20 10 4.5</size></box></geometry>
          <material><ambient>0.26 0.25 0.24 1</ambient><diffuse>0.38 0.36 0.33 1</diffuse></material>
        </visual>

        <collision name="front_wall_collision">
          <pose>11 0 2.25 0 0 0</pose>
          <geometry><box><size>0.20 10 4.5</size></box></geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>11 0 2.25 0 0 0</pose>
          <geometry><box><size>0.20 10 4.5</size></box></geometry>
          <material><ambient>0.26 0.25 0.24 1</ambient><diffuse>0.38 0.36 0.33 1</diffuse></material>
        </visual>

        <collision name="ceiling_collision">
          <pose>4 0 4.55 0 0 0</pose>
          <geometry><box><size>14 10 0.20</size></box></geometry>
        </collision>
        <visual name="ceiling_visual">
          <pose>4 0 4.55 0 0 0</pose>
          <geometry><box><size>14 10 0.20</size></box></geometry>
          <material><ambient>0.20 0.20 0.21 1</ambient><diffuse>0.30 0.30 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The 5 m target is at world x=5. This obstacle is centred 2.5 m in
         front of takeoff and spans the full usable height, forcing SUPER to
         choose a left/right route. Each side retains over 3 m of free width. -->
    <model name="center_obstacle">
      <static>true</static>
      <pose>2.5 0 2.25 0 0 0</pose>
      <link name="obstacle">
        <collision name="collision">
          <geometry><box><size>0.60 1.40 4.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.60 1.40 4.50</size></box></geometry>
          <material><ambient>0.65 0.22 0.08 1</ambient><diffuse>0.90 0.30 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light name="test_light" type="point">
      <pose>1 0 3.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.005</quadratic></attenuation>
      <cast_shadows>true</cast_shadows>
    </light>
  </world>
</sdf>
