<?xml version="1.0"?>
<sdf version="1.6">
  <world name="omnilivo_regression_40x40x30">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.06 0.07 0.08 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- The aircraft starts on this platform at z=15 m and flies along +x. -->
    <model name="entrance_platform">
      <static>true</static>
      <pose>-8 0 14.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 14 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 14 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="left_wall">
      <static>true</static><pose>20 20 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 0.4 30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 0.4 30</size></box></geometry></visual>
      </link>
    </model>
    <model name="right_wall">
      <static>true</static><pose>20 -20 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 0.4 30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 0.4 30</size></box></geometry></visual>
      </link>
    </model>
    <model name="far_wall">
      <static>true</static><pose>40 0 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 40 30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 40 30</size></box></geometry></visual>
      </link>
    </model>
    <model name="ceiling">
      <static>true</static><pose>20 0 30 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 40 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 40 0.4</size></box></geometry></visual>
      </link>
    </model>
    <model name="chamber_floor">
      <static>true</static><pose>20 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 40 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 40 0.2</size></box></geometry></visual>
      </link>
    </model>

    <!-- Asymmetric, static LiDAR landmarks.  All stay more than 3 m from the
         y=0 flight corridor, so they improve observability without becoming
         artificial near-field hazards. -->
    <model name="lio_landmark_near_left_x_slab">
      <static>true</static><pose>-4 6.5 18 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 5.0 12.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 5.0 12.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="lio_landmark_near_right_x_slab">
      <static>true</static><pose>0 -6.5 11 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 5.0 10.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 5.0 10.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="lio_landmark_left_column">
      <static>true</static><pose>4 6.5 15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 2.4 9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 2.4 9</size></box></geometry></visual>
      </link>
    </model>
    <model name="lio_landmark_right_beam">
      <static>true</static><pose>8 -7 19 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.0 1.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.0 1.2 2.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="lio_landmark_left_slab">
      <static>true</static><pose>13 8.5 13.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 4.0 11</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 4.0 11</size></box></geometry></visual>
      </link>
    </model>
    <model name="lio_landmark_right_block">
      <static>true</static><pose>18 -8 11 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 2.0 5.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 2.0 5.0</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
