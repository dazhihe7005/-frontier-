<?xml version="1.0"?>
<sdf version="1.6">
  <world name="shaft_500m_logic_sitl">
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.06 0.06 0.07 1</background>
      <shadows>false</shadows>
    </scene>
    <!-- Entrance reference z=+0.25 m; bottom top z=-499.75 m: 500 m depth. -->
    <model name="shaft_launch_pad">
      <static>true</static><pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 3 0.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 3 0.2</size></box></geometry></visual>
      </link>
    </model>
    <model name="shaft_bottom">
      <static>true</static><pose>0 0 -500.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 10 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 10 1</size></box></geometry></visual>
      </link>
    </model>
    <model name="shaft_east_wall">
      <static>true</static><pose>5.2 0 -249.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 10 502</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.4 10 502</size></box></geometry></visual></link>
    </model>
    <model name="shaft_west_wall">
      <static>true</static><pose>-5.2 0 -249.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 10 502</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.4 10 502</size></box></geometry></visual></link>
    </model>
    <model name="shaft_north_wall">
      <static>true</static><pose>0 5.2 -249.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>10 0.4 502</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>10 0.4 502</size></box></geometry></visual></link>
    </model>
    <model name="shaft_south_wall">
      <static>true</static><pose>0 -5.2 -249.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>10 0.4 502</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>10 0.4 502</size></box></geometry></visual></link>
    </model>
  </world>
</sdf>
