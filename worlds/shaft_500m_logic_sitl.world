<?xml version="1.0"?>
<sdf version="1.6">
  <world name="shaft_500m_logic_sitl">
    <include><uri>model://sun</uri></include>
    <scene>
      <ambient>0.34 0.35 0.37 1</ambient>
      <background>0.035 0.038 0.043 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- The mesh has a nominal 2.50 m inner radius and deterministic
         multi-scale radial relief over the full 500 m depth. Both lidar rays
         and vehicle contacts use the same triangular geometry. -->
    <include>
      <uri>model://shaft_rock_500m</uri>
      <name>shaft_rock_500m</name>
    </include>

    <!-- Removed automatically after the initial PX4 hover. -->
    <model name="shaft_launch_pad">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 3 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>3 3 0.2</size></box></geometry>
          <material><ambient>0.18 0.18 0.19 1</ambient><diffuse>0.30 0.30 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
