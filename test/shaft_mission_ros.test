<launch>
  <node pkg="mine_uav_control" type="shaft_mission_node"
        name="shaft_mission_node_test" output="screen">
    <rosparam command="load" file="$(find mine_uav_control)/config/shaft_mission_logic.yaml"/>
    <param name="required_depth_source" value="ros_test_depth"/>
    <param name="required_range_frame" value="ros_test_range"/>
    <param name="range_topic" value="/mine_uav/shaft/bottom_range"/>
    <param name="max_depth_sigma_m" value="0.25"/>
    <param name="entrance_tolerance" value="0.5"/>
  </node>
  <test pkg="mine_uav_control" type="test_shaft_ros_logic.py"
        test-name="shaft_mission_ros_logic" time-limit="30.0"/>
</launch>
