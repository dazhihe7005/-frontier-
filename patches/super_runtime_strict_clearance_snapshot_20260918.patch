diff --git a/super_planner/include/super_core/horizontal_clearance_contract.h b/super_planner/include/super_core/horizontal_clearance_contract.h
new file mode 100644
--- /dev/null
+++ b/super_planner/include/super_core/horizontal_clearance_contract.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cmath>
+#include <Eigen/Core>
+
+namespace super_planner {
+
+// Inset only an obstacle half-space.  The support function of a horizontal
+// disk of radius extra is extra * ||n_xy||; vertical flight bounds are not
+// contracted.  An infeasible seed is rejected before optimization.
+inline bool insetObstaclePlaneHorizontal(
+    const Eigen::Vector4d& plane, double extra,
+    const Eigen::Vector3d& start, const Eigen::Vector3d& end,
+    Eigen::Vector4d& inset) {
+    if (!plane.allFinite() || !start.allFinite() || !end.allFinite() ||
+        !std::isfinite(extra) || extra < 0.0) return false;
+    inset = plane;
+    inset(3) += extra * plane.head<2>().norm();
+    if (!inset.allFinite()) return false;
+    return inset.head<3>().dot(start) + inset(3) <= 1e-8 &&
+           inset.head<3>().dot(end) + inset(3) <= 1e-8;
+}
+
+}  // namespace super_planner
diff --git a/super_planner/include/super_core/path_start_guard.h b/super_planner/include/super_core/path_start_guard.h
new file mode 100644
--- /dev/null
+++ b/super_planner/include/super_core/path_start_guard.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <cstddef>
+#include <optional>
+
+namespace super_planner {
+
+template <typename Path, typename IsOccupied>
+std::optional<std::size_t> firstUnoccupiedPathIndex(
+    const Path& path, IsOccupied is_occupied) {
+    for (std::size_t i = 0; i < path.size(); ++i) {
+        if (!is_occupied(path[i])) return i;
+    }
+    return std::nullopt;
+}
+
+}  // namespace super_planner
diff --git a/super_planner/test/horizontal_clearance_contract_test.cpp b/super_planner/test/horizontal_clearance_contract_test.cpp
new file mode 100644
--- /dev/null
+++ b/super_planner/test/horizontal_clearance_contract_test.cpp
@@ -0,0 +1,40 @@
+#include <gtest/gtest.h>
+
+#include <super_core/horizontal_clearance_contract.h>
+
+namespace {
+
+TEST(HorizontalClearanceContract, InsetsWallByExactHorizontalMargin) {
+  Eigen::Vector4d plane(1.0, 0.0, 0.0, -2.0), inset;
+  const Eigen::Vector3d seed(0.5, 0.0, 1.5);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, seed, seed, inset));
+  EXPECT_NEAR(inset(3), -1.0, 1e-12);
+  EXPECT_NEAR(inset.head<3>().dot(Eigen::Vector3d(1.0, 0.0, 1.5)) +
+                  inset(3), 0.0, 1e-12);
+}
+
+TEST(HorizontalClearanceContract, DoesNotMoveVerticalObstaclePlane) {
+  Eigen::Vector4d plane(0.0, 0.0, -1.0, 0.4), inset;
+  const Eigen::Vector3d seed(0.0, 0.0, 1.5);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, seed, seed, inset));
+  EXPECT_TRUE(inset.isApprox(plane));
+}
+
+TEST(HorizontalClearanceContract, InsetsObliquePlaneByHorizontalSupport) {
+  Eigen::Vector4d plane(0.6, 0.0, 0.8, -2.0), inset;
+  const Eigen::Vector3d seed(0.0, 0.0, 1.0);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, seed, seed, inset));
+  EXPECT_NEAR(inset(3), -1.4, 1e-12);
+}
+
+TEST(HorizontalClearanceContract, RejectsSeedCutByRequiredMargin) {
+  Eigen::Vector4d plane(1.0, 0.0, 0.0, -2.0), inset;
+  EXPECT_FALSE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, Eigen::Vector3d(1.1, 0.0, 1.5),
+      Eigen::Vector3d(0.5, 0.0, 1.5), inset));
+}
+
+}  // namespace
diff --git a/super_planner/test/path_start_guard_test.cpp b/super_planner/test/path_start_guard_test.cpp
new file mode 100644
--- /dev/null
+++ b/super_planner/test/path_start_guard_test.cpp
@@ -0,0 +1,26 @@
+#include <gtest/gtest.h>
+#include <super_core/path_start_guard.h>
+#include <vector>
+
+TEST(PathStartGuard, RejectsEmptyPath) {
+    const std::vector<int> path;
+    EXPECT_FALSE(super_planner::firstUnoccupiedPathIndex(path,
+        [](int) { return true; }).has_value());
+}
+
+TEST(PathStartGuard, RejectsFullyOccupiedPathWithoutOutOfBoundsRead) {
+    const std::vector<int> path{1, 2, 3};
+    std::size_t calls = 0;
+    const auto index = super_planner::firstUnoccupiedPathIndex(path,
+        [&calls](int) { ++calls; return true; });
+    EXPECT_FALSE(index.has_value());
+    EXPECT_EQ(calls, path.size());
+}
+
+TEST(PathStartGuard, FindsFirstFreePoint) {
+    const std::vector<int> path{1, 2, 3};
+    const auto index = super_planner::firstUnoccupiedPathIndex(path,
+        [](int point) { return point < 3; });
+    ASSERT_TRUE(index.has_value());
+    EXPECT_EQ(*index, 2U);
+}
