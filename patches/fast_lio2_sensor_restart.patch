+bool sensorTimeDiscontinuity(const char *sensor_name, double previous,
+                             double current, double max_gap)
+{
+    if (!restart_on_time_discontinuity || previous <= 0.0) return false;
+    const double delta = current - previous;
+    if (delta >= 0.0 && delta <= max_gap) return false;
+
+    ROS_ERROR("%s timestamp discontinuity (previous=%.9f current=%.9f delta=%.3f s); "
+              "shutting down so roslaunch can restart Fast-LIO with a fresh EKF/map",
+              sensor_name, previous, current, delta);
+    ros::shutdown();
+    return true;
+}
