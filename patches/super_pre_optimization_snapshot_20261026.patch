+            gi_.new_goal = false;
+            consecutive_plan_failures_ = 0;
+            first_plan_failure_time_ = -1.0;
+            consecutive_replan_failures_ = 0;
+            traj_finish_ = false;
+            plan_from_rest_ = false;
+            finish_plan = true;
+            started_ = false;
+            machine_state_ = WAIT_GOAL;
+        });
+        if (canceled) {
