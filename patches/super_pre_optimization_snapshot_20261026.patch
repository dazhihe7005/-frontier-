+
+    double SuperPlanner::committedTrajectoryTimeAt(double wall_time) const {
+        const auto snapshot = cmd_traj_info_.heartbeatSnapshot();
+        if (!std::isfinite(wall_time) ||
+            !std::isfinite(snapshot.start_wall_time) ||
+            !std::isfinite(snapshot.total_duration) ||
+            snapshot.total_duration <= 0.0) {
+            return 0.0;
+        }
+        return std::max(
+            0.0, std::min(wall_time - snapshot.start_wall_time,
+                          snapshot.total_duration));
+    }
+
+    void SuperPlanner::resumeCommittedTrajectoryAt(
+            double wall_time, double trajectory_time) {
+        if (!std::isfinite(wall_time) || !std::isfinite(trajectory_time)) return;
+        const auto snapshot = cmd_traj_info_.heartbeatSnapshot();
+        if (!std::isfinite(snapshot.total_duration) ||
+            snapshot.total_duration <= 0.0) return;
+        const double bounded_time = std::max(
+            0.0, std::min(trajectory_time, snapshot.total_duration));
+        const double start_wall_time = wall_time - bounded_time;
+        std::lock_guard<std::mutex> guard(replan_lock_);
+        cmd_traj_info_.setStartWallTime(start_wall_time);
+        if (!last_exp_traj_info_.empty()) {
+            last_exp_traj_info_.setStartWallTime(start_wall_time);
+        }
+        robot_on_backup_traj_ = false;
+    }
+
+    bool SuperPlanner::pauseCommittedTrajectoryAt(
+            double wall_time, const PlannerCommitGate& gate,
+            const std::function<void(double)>& state_commit) {
+        if (!std::isfinite(wall_time) || !gate || !state_commit) return false;
+        std::lock_guard<std::mutex> guard(replan_lock_);
+        const auto snapshot = cmd_traj_info_.heartbeatSnapshot();
+        if (!std::isfinite(snapshot.start_wall_time) ||
+            !std::isfinite(snapshot.total_duration) ||
+            snapshot.total_duration <= 0.0) {
+            return false;
+        }
+        const double trajectory_time = std::max(
+            0.0, std::min(wall_time - snapshot.start_wall_time,
+                          snapshot.total_duration));
+        return gate([&] {
+            state_commit(trajectory_time);
+            return true;
+        }, false);
+    }
+
+    bool SuperPlanner::rebaseCommittedTrajectoryAt(
+            double wall_time, const PlannerCommitGate& gate,
+            const std::function<double()>& trajectory_time,
+            const std::function<void()>& state_commit) {
+        if (!std::isfinite(wall_time) || !gate || !trajectory_time ||
+            !state_commit) {
+            return false;
+        }
+        std::lock_guard<std::mutex> guard(replan_lock_);
+        const auto snapshot = cmd_traj_info_.heartbeatSnapshot();
+        if (!std::isfinite(snapshot.total_duration) ||
+            snapshot.total_duration <= 0.0) {
+            return false;
+        }
+        return gate([&] {
+            const double requested_time = trajectory_time();
+            if (!std::isfinite(requested_time)) return false;
+            const double bounded_time = std::max(
+                0.0, std::min(requested_time, snapshot.total_duration));
+            const double start_wall_time = wall_time - bounded_time;
+            cmd_traj_info_.setStartWallTime(start_wall_time);
+            if (!last_exp_traj_info_.empty()) {
+                last_exp_traj_info_.setStartWallTime(start_wall_time);
+            }
+            robot_on_backup_traj_ = false;
+            state_commit();
+            return true;
+        }, false);
+    }
