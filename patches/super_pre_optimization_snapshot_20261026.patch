+  command.goal_id = 0;
+  EXPECT_TRUE(fsm::validateGoalCommand(command, 11));
+  EXPECT_TRUE(fsm::validateGoalCommand(command, 0));
+}
diff --git a/super_planner/test/goal_lifecycle_guard_test.cpp b/super_planner/test/goal_lifecycle_guard_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..708155ce170a8918b9562043ea661d24c3e3aff5
--- /dev/null
+++ b/super_planner/test/goal_lifecycle_guard_test.cpp
@@ -0,0 +1,133 @@
+#include <gtest/gtest.h>
+
+#include <fsm/goal_lifecycle_guard.h>
+
+#include <chrono>
+#include <future>
+
+TEST(GoalLifecycleGuard, CancelInvalidatesInflightPlanningToken) {
+  fsm::GoalLifecycleGuard guard;
+  const auto old = guard.activate(11);
+  ASSERT_TRUE(guard.cancel(11));
+  bool committed = false;
+  EXPECT_FALSE(guard.commitIfCurrent(old, [&] { committed = true; }));
+  EXPECT_FALSE(committed);
+}
+
+TEST(GoalLifecycleGuard, NewGoalRejectsOldResultAndAcceptsNewResult) {
+  fsm::GoalLifecycleGuard guard;
+  const auto old = guard.activate(11);
+  const auto current = guard.activate(12);
+  EXPECT_FALSE(guard.commitIfCurrent(old, [] {}));
+  EXPECT_TRUE(guard.commitIfCurrent(current, [] {}));
+}
+
+TEST(GoalLifecycleGuard, StaleSpecificCancelCannotCancelNewGoal) {
+  fsm::GoalLifecycleGuard guard;
+  guard.activate(12);
+  EXPECT_FALSE(guard.cancel(11));
+  EXPECT_TRUE(guard.isActive());
+  EXPECT_EQ(guard.activeGoalId(), 12u);
+}
+
+TEST(GoalLifecycleGuard, ZeroIdCancelIsUnconditional) {
+  fsm::GoalLifecycleGuard guard;
+  guard.activate(12);
+  EXPECT_TRUE(guard.cancel(0));
+  EXPECT_FALSE(guard.isActive());
+}
+
+TEST(GoalLifecycleGuard, ReactivatingSameGoalAdvancesEpoch) {
+  fsm::GoalLifecycleGuard guard;
+  const auto old = guard.activate(12);
+  const auto current = guard.activate(12);
+  EXPECT_GT(current.epoch, old.epoch);
+  EXPECT_FALSE(guard.runIfCurrent(old, [] {}));
+  EXPECT_TRUE(guard.runIfCurrent(current, [] {}));
+}
+
+TEST(GoalLifecycleGuard, ActivationCallbackRunsWithNewGoalActive) {
+  fsm::GoalLifecycleGuard guard;
+  bool callback_ran = false;
+  const auto token = guard.activate(21, [&] { callback_ran = true; });
+  EXPECT_TRUE(callback_ran);
+  EXPECT_EQ(token.goal_id, 21u);
+  EXPECT_TRUE(guard.isActive());
+  EXPECT_EQ(guard.activeGoalId(), 21u);
+}
+
+TEST(GoalLifecycleGuard, RejectedCancelDoesNotRunCallback) {
+  fsm::GoalLifecycleGuard guard;
+  guard.activate(21);
+  bool callback_ran = false;
+  EXPECT_FALSE(guard.cancel(22, [&] { callback_ran = true; }));
+  EXPECT_FALSE(callback_ran);
+  EXPECT_TRUE(guard.isActive());
+}
+
+TEST(GoalLifecycleGuard, SuccessfulCancelRunsCallbackAndClearsGoal) {
+  fsm::GoalLifecycleGuard guard;
+  guard.activate(21);
+  bool callback_ran = false;
+  EXPECT_TRUE(guard.cancel(21, [&] { callback_ran = true; }));
+  EXPECT_TRUE(callback_ran);
+  EXPECT_FALSE(guard.isActive());
+  EXPECT_EQ(guard.activeGoalId(), 0u);
+}
+
+TEST(GoalLifecycleGuard, SnapshotTracksEpochAndCancellation) {
+  fsm::GoalLifecycleGuard guard;
+  EXPECT_FALSE(guard.snapshot().has_value());
+
+  const auto first = guard.activate(12);
+  const auto first_snapshot = guard.snapshot();
+  ASSERT_TRUE(first_snapshot.has_value());
+  EXPECT_EQ(first_snapshot->epoch, first.epoch);
+  EXPECT_EQ(first_snapshot->goal_id, first.goal_id);
+
+  const auto second = guard.activate(12);
+  const auto second_snapshot = guard.snapshot();
+  ASSERT_TRUE(second_snapshot.has_value());
+  EXPECT_EQ(second_snapshot->epoch, second.epoch);
+  EXPECT_EQ(second_snapshot->goal_id, second.goal_id);
+  EXPECT_NE(second_snapshot->epoch, first_snapshot->epoch);
+  EXPECT_FALSE(guard.commitIfCurrent(*first_snapshot, [] {}));
+  EXPECT_TRUE(guard.runIfCurrent(*second_snapshot, [] {}));
+
+  ASSERT_TRUE(guard.cancel(12));
+  EXPECT_FALSE(guard.snapshot().has_value());
+  EXPECT_FALSE(guard.commitIfCurrent(*second_snapshot, [] {}));
+}
+
+TEST(GoalLifecycleGuard, CommitCallbackAndCancelAreLinearized) {
+  using namespace std::chrono;
+  fsm::GoalLifecycleGuard guard;
+  const auto token = guard.activate(42);
+  std::promise<void> callback_entered;
+  std::promise<void> release_callback;
+  std::promise<void> cancel_started;
+  auto entered = callback_entered.get_future();
+  auto release = release_callback.get_future();
+  auto started = cancel_started.get_future();
+
+  auto commit = std::async(std::launch::async, [&] {
+    return guard.commitIfCurrent(token, [&] {
+      callback_entered.set_value();
+      release.wait();
+    });
+  });
+  entered.wait();
+
+  auto cancel = std::async(std::launch::async, [&] {
+    cancel_started.set_value();
+    return guard.cancel(42);
+  });
+  started.wait();
+  EXPECT_EQ(cancel.wait_for(milliseconds(50)), std::future_status::timeout);
+  release_callback.set_value();
+
+  EXPECT_TRUE(commit.get());
+  EXPECT_TRUE(cancel.get());
+  EXPECT_FALSE(guard.snapshot().has_value());
+  EXPECT_FALSE(guard.commitIfCurrent(token, [] {}));
+}
diff --git a/super_planner/test/guide_time_initialization_test.cpp b/super_planner/test/guide_time_initialization_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..45b1a25dcffc01ab5b09f0b8785219b6422f63ac
--- /dev/null
+++ b/super_planner/test/guide_time_initialization_test.cpp
@@ -0,0 +1,99 @@
+#include <gtest/gtest.h>
+
+#include <limits>
+
+#include <traj_opt/guide_time_initialization.h>
+
+namespace {
+
+using super_utils::Mat3Df;
+using super_utils::VecDf;
+
+TEST(GuideTimeInitialization,
+     RaisesDegenerateNonzeroSegmentToVelocityBound) {
+    Mat3Df path(3, 3);
+    path.col(0) << 0.0, 0.0, 0.0;
+    path.col(1) << 1.0, 0.0, 0.0;
+    path.col(2) << 1.4, 0.0, 0.0;
+    VecDf times(2);
+    times << 1.0, 0.008;
+
+    ASSERT_TRUE(traj_opt::applyGeometricTimeLowerBound(path, 1.0, times));
+
+    EXPECT_DOUBLE_EQ(times(0), 1.0);
+    EXPECT_NEAR(times(1), 0.4, 1.0e-12);
+}
+
+TEST(GuideTimeInitialization, PreservesLongerGuideDuration) {
+    Mat3Df path(3, 2);
+    path.col(0) << 0.0, 0.0, 0.0;
+    path.col(1) << 0.4, 0.0, 0.0;
+    VecDf times(1);
+    times << 0.75;
+
+    ASSERT_TRUE(traj_opt::applyGeometricTimeLowerBound(path, 1.0, times));
+
+    EXPECT_DOUBLE_EQ(times(0), 0.75);
+}
+
+TEST(GuideTimeInitialization, DoesNotInflateZeroLengthSegment) {
+    Mat3Df path(3, 2);
+    path.col(0) << 2.0, -1.0, 0.5;
+    path.col(1) = path.col(0);
+    VecDf times(1);
+    times << 0.008;
+
+    ASSERT_TRUE(traj_opt::applyGeometricTimeLowerBound(path, 1.0, times));
+
+    EXPECT_DOUBLE_EQ(times(0), 0.008);
+}
+
+TEST(GuideTimeInitialization, RejectsNonFinitePath) {
+    Mat3Df path(3, 2);
+    path.setZero();
+    path(0, 1) = std::numeric_limits<double>::quiet_NaN();
+    VecDf times(1);
+    times << 0.5;
+
+    EXPECT_FALSE(traj_opt::applyGeometricTimeLowerBound(path, 1.0, times));
+}
+
+TEST(GuideTimeInitialization, RejectsNonFiniteTime) {
+    Mat3Df path(3, 2);
+    path.setZero();
+    VecDf times(1);
+    times << std::numeric_limits<double>::infinity();
+
+    EXPECT_FALSE(traj_opt::applyGeometricTimeLowerBound(path, 1.0, times));
+}
+
+TEST(GuideTimeInitialization, RejectsNegativeTime) {
+    Mat3Df path(3, 2);
+    path.setZero();
+    path(0, 1) = 0.4;
+    VecDf times(1);
+    times << -0.1;
+
+    EXPECT_FALSE(traj_opt::applyGeometricTimeLowerBound(path, 1.0, times));
+}
+
+TEST(GuideTimeInitialization, RejectsInvalidVelocityAndDimensions) {
+    Mat3Df path(3, 2);
+    path.setZero();
+    VecDf times(1);
+    times << 0.5;
+
+    EXPECT_FALSE(traj_opt::applyGeometricTimeLowerBound(path, 0.0, times));
+
+    Mat3Df mismatched_path(3, 3);
+    mismatched_path.setZero();
+    EXPECT_FALSE(traj_opt::applyGeometricTimeLowerBound(
+            mismatched_path, 1.0, times));
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    testing::InitGoogleTest(&argc, argv);
+    return RUN_ALL_TESTS();
+}
diff --git a/super_planner/test/horizontal_clearance_contract_test.cpp b/super_planner/test/horizontal_clearance_contract_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ce95ffb42f39488596fb235aaf37c15b1f7717a0
--- /dev/null
+++ b/super_planner/test/horizontal_clearance_contract_test.cpp
@@ -0,0 +1,143 @@
+#include <gtest/gtest.h>
+#include <limits>
+
+#include <super_core/horizontal_clearance_contract.h>
+
+TEST(HorizontalClearanceContract, PreferredPenaltyIsGraded) {
+  const double margin_steps = 5.0;
+  const double at_preferred_boundary =
+      super_planner::preferredClearancePenaltyMultiplier(5.0, margin_steps);
+  const double in_middle =
+      super_planner::preferredClearancePenaltyMultiplier(3.0, margin_steps);
+  const double at_hard_boundary =
+      super_planner::preferredClearancePenaltyMultiplier(1.0, margin_steps);
+
+  EXPECT_DOUBLE_EQ(at_preferred_boundary, 1.0);
+  EXPECT_DOUBLE_EQ(in_middle, 1.5);
+  EXPECT_DOUBLE_EQ(at_hard_boundary, 2.0);
+  EXPECT_LT(at_preferred_boundary, in_middle);
+  EXPECT_LT(in_middle, at_hard_boundary);
+}
+
+TEST(HorizontalClearanceContract, PreferredPenaltyIsZeroOutsideEnvelope) {
+  EXPECT_DOUBLE_EQ(super_planner::preferredClearancePenaltyMultiplier(
+                       std::numeric_limits<double>::infinity(), 5.0),
+                   0.0);
+  EXPECT_DOUBLE_EQ(
+      super_planner::preferredClearancePenaltyMultiplier(5.1, 5.0), 0.0);
+}
+
+TEST(HorizontalClearanceContract, PreferredRewardCannotDominatePathLength) {
+  EXPECT_DOUBLE_EQ(
+      super_planner::explorationFirstPreferredClearancePenalty(
+          1.0, 1000.0, 2.0),
+      0.5);
+  EXPECT_DOUBLE_EQ(
+      super_planner::explorationFirstPreferredClearancePenalty(
+          1.0, 0.2, 1.5),
+      0.3);
+}
+
+TEST(HorizontalClearanceContract, HorizonPathMustAdvanceTowardGoal) {
+  const Eigen::Vector3d start(7.5, -0.3, 0.7);
+  const Eigen::Vector3d goal(9.45, 0.15, 0.55);
+  EXPECT_TRUE(super_planner::horizonEndpointMakesGoalProgress(
+      start, goal, Eigen::Vector3d(8.5, 0.0, 0.6), 0.1));
+  // Regression for the 2026-10-18 flight: this path consumed the complete
+  // seven-metre horizon but ended behind the aircraft near x=1.75.
+  EXPECT_FALSE(super_planner::horizonEndpointMakesGoalProgress(
+      start, goal, Eigen::Vector3d(1.75, 0.45, 0.7), 0.1));
+  EXPECT_FALSE(super_planner::horizonEndpointMakesGoalProgress(
+      start, goal, Eigen::Vector3d(7.5, 1.0, 0.7), 0.1));
+}
+
+TEST(HorizontalClearanceContract, ExactSeedPlanePreservesSafeStraightRoute) {
+  const Eigen::Vector3d obstacle(5.35, 1.25, 0.65);
+  const Eigen::Vector3d start(-0.15, 0.05, 0.45);
+  const Eigen::Vector3d end(4.68907990233379, -0.04516299985850823,
+                            0.4880058801711589);
+  Eigen::Vector4d plane;
+  ASSERT_TRUE(super_planner::horizontalClearancePlaneForSeed(
+      obstacle, 1.2, start, end, plane));
+  EXPECT_LE(plane.head<3>().dot(start) + plane(3), 1e-8);
+  EXPECT_LE(plane.head<3>().dot(end) + plane(3), 1e-8);
+  EXPECT_NEAR(plane.head<3>().dot(obstacle) + plane(3), 1.2, 1e-8);
+  EXPECT_NEAR(plane.z(), 0.0, 1e-12);
+}
+
+TEST(HorizontalClearanceContract, ExactSeedPlaneAcceptsEightMillimetreMargin) {
+  // Reproduced from the 2026-10-17 real flight.  The old oblique-plane inset
+  // rejected this 1.208 m-clear seed and pushed replans toward the wall.
+  const Eigen::Vector3d obstacle(2.85, -2.05, 0.45);
+  const Eigen::Vector3d start(-0.15, 0.05, 0.45);
+  const Eigen::Vector3d end(2.59325643451887, -0.8689345039224361,
+                            0.4440293185575902);
+  Eigen::Vector4d plane;
+  ASSERT_TRUE(super_planner::horizontalClearancePlaneForSeed(
+      obstacle, 1.2, start, end, plane));
+  EXPECT_LE(plane.head<3>().dot(start) + plane(3), 1e-8);
+  EXPECT_LE(plane.head<3>().dot(end) + plane(3), 1e-8);
+}
+
+TEST(HorizontalClearanceContract, ExactSeedPlaneRejectsUnsafeSeed) {
+  const Eigen::Vector3d obstacle(0.0, 0.0, 0.0);
+  const Eigen::Vector3d start(0.5, 0.0, 0.4);
+  const Eigen::Vector3d end(0.9, 0.0, 0.4);
+  Eigen::Vector4d plane;
+  EXPECT_FALSE(super_planner::horizontalClearancePlaneForSeed(
+      obstacle, 1.2, start, end, plane));
+}
+
+namespace {
+
+TEST(HorizontalClearanceContract, InsetsWallByExactHorizontalMargin) {
+  Eigen::Vector4d plane(1.0, 0.0, 0.0, -2.0), inset;
+  const Eigen::Vector3d seed(0.5, 0.0, 1.5);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, seed, seed, inset));
+  EXPECT_NEAR(inset(3), -1.0, 1e-12);
+  EXPECT_NEAR(inset.head<3>().dot(Eigen::Vector3d(1.0, 0.0, 1.5)) +
+                  inset(3), 0.0, 1e-12);
+}
+
+TEST(HorizontalClearanceContract, DoesNotMoveVerticalObstaclePlane) {
+  Eigen::Vector4d plane(0.0, 0.0, -1.0, 0.4), inset;
+  const Eigen::Vector3d seed(0.0, 0.0, 1.5);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, seed, seed, inset));
+  EXPECT_TRUE(inset.isApprox(plane));
+}
+
+TEST(HorizontalClearanceContract, InsetsObliquePlaneByHorizontalSupport) {
+  Eigen::Vector4d plane(0.6, 0.0, 0.8, -2.0), inset;
+  const Eigen::Vector3d seed(0.0, 0.0, 1.0);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, seed, seed, inset));
+  EXPECT_NEAR(inset(3), -1.4, 1e-12);
+}
+
+TEST(HorizontalClearanceContract, RejectsSeedCutByRequiredMargin) {
+  Eigen::Vector4d plane(1.0, 0.0, 0.0, -2.0), inset;
+  EXPECT_FALSE(super_planner::insetObstaclePlaneHorizontal(
+      plane, 1.0, Eigen::Vector3d(1.1, 0.0, 1.5),
+      Eigen::Vector3d(0.5, 0.0, 1.5), inset));
+}
+
+TEST(HorizontalClearanceContract, SixTenthsSphereAddsFourTenthsHorizontally) {
+  // The base CIRI sphere supplies 0.6 m in every direction. A 0.4 m
+  // horizontal-only inset makes wall clearance 1.0 m without changing a
+  // floor/ceiling plane.
+  Eigen::Vector4d wall(1.0, 0.0, 0.0, -0.6), inset;
+  const Eigen::Vector3d seed(-0.4, 0.0, 1.0);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      wall, 0.4, seed, seed, inset));
+  EXPECT_NEAR(inset(3), -0.2, 1e-12);
+
+  Eigen::Vector4d floor(0.0, 0.0, -1.0, 0.6);
+  ASSERT_TRUE(super_planner::insetObstaclePlaneHorizontal(
+      floor, 0.4, Eigen::Vector3d(0.0, 0.0, 1.0),
+      Eigen::Vector3d(0.0, 0.0, 1.0), inset));
+  EXPECT_TRUE(inset.isApprox(floor));
+}
+
+}  // namespace
diff --git a/super_planner/test/horizontal_cylinder_safety_test.cpp b/super_planner/test/horizontal_cylinder_safety_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9ae2608c3a1c729bd891c04b57a47efc387849b2
--- /dev/null
