+    bool SuperPlanner::canRetargetCurrentTrajectory(double min_remaining) const {
+        const auto snapshot = cmd_traj_info_.heartbeatSnapshot();
+        const double elapsed = ros_ptr_->getSimTime() - snapshot.start_wall_time;
+        const double remaining = snapshot.total_duration - elapsed;
+        // Retarget only while there is enough moving trajectory left to splice.
+        // Treating a nearly-ended trajectory as reusable made a successor goal
+        // inherit the old terminal zero-velocity state and caused stop/start
+        // motion at every task-level handover.
+        return snapshot.total_duration > 0.0 && std::isfinite(elapsed) &&
+               std::isfinite(min_remaining) && min_remaining >= 0.0 &&
+               elapsed >= 0.0 && remaining >= min_remaining;
+    }
