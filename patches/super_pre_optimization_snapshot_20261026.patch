@@ -0,0 +1,26 @@
+#include <gtest/gtest.h>
+#include <super_core/path_start_guard.h>
+#include <vector>
+
+TEST(PathStartGuard, RejectsEmptyPath) {
+    const std::vector<int> path;
+    EXPECT_FALSE(super_planner::firstUnoccupiedPathIndex(path,
+        [](int) { return true; }).has_value());
+}
+
+TEST(PathStartGuard, RejectsFullyOccupiedPathWithoutOutOfBoundsRead) {
+    const std::vector<int> path{1, 2, 3};
+    std::size_t calls = 0;
+    const auto index = super_planner::firstUnoccupiedPathIndex(path,
+        [&calls](int) { ++calls; return true; });
+    EXPECT_FALSE(index.has_value());
+    EXPECT_EQ(calls, path.size());
+}
+
+TEST(PathStartGuard, FindsFirstFreePoint) {
+    const std::vector<int> path{1, 2, 3};
+    const auto index = super_planner::firstUnoccupiedPathIndex(path,
+        [](int point) { return point < 3; });
+    ASSERT_TRUE(index.has_value());
+    EXPECT_EQ(*index, 2U);
+}
diff --git a/super_planner/test/trajectory_partial_test.cpp b/super_planner/test/trajectory_partial_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f2c8aa3173c4b0f5192009ab515780c09cf7e90b
--- /dev/null
+++ b/super_planner/test/trajectory_partial_test.cpp
@@ -0,0 +1,150 @@
+#include <gtest/gtest.h>
+
+#include <limits>
+
+#include <data_structure/base/trajectory.h>
+#include <super_core/super_planner.h>
+#include <super_core/yaw_prealignment_guard.h>
+
+namespace {
+
+geometry_utils::Trajectory makeMixedOrderTrajectory() {
+    geometry_utils::Trajectory trajectory;
+
+    Eigen::MatrixXd hold = Eigen::MatrixXd::Zero(3, 2);
+    hold(0, 1) = 2.0;
+    hold(1, 1) = -1.0;
+    trajectory.emplace_back(1.5, hold);
+
+    Eigen::MatrixXd cubic = Eigen::MatrixXd::Zero(3, 4);
+    cubic(0, 0) = 0.1;
+    cubic(0, 1) = -0.2;
+    cubic(0, 2) = 0.5;
+    cubic(0, 3) = 2.0;
+    cubic(1, 1) = 0.3;
+    cubic(1, 2) = -0.4;
+    cubic(1, 3) = -1.0;
+    trajectory.emplace_back(2.0, cubic);
+    trajectory.start_WT = 10.0;
+    return trajectory;
+}
+
+geometry_utils::Trajectory makeSeventhOrderTrajectory() {
+    geometry_utils::Trajectory trajectory;
+    Eigen::MatrixXd coefficients(3, 8);
+    coefficients <<
+        0.007, -0.021, 0.035, -0.049, 0.063, -0.077, 0.091, 1.3,
+       -0.008,  0.018, 0.028, -0.038, 0.048,  0.058, -0.068, -0.7,
+        0.009,  0.019, -0.029, -0.039, 0.049, -0.059, 0.069, 2.1;
+    trajectory.emplace_back(2.4, coefficients);
+    trajectory.start_WT = 20.0;
+    return trajectory;
+}
+
+void expectSameState(const geometry_utils::Trajectory& original,
+                     const geometry_utils::Trajectory& partial,
+                     double original_time, double partial_time) {
+    EXPECT_TRUE(original.getPos(original_time).isApprox(
+        partial.getPos(partial_time), 1e-10));
+    EXPECT_TRUE(original.getVel(original_time).isApprox(
+        partial.getVel(partial_time), 1e-10));
+    EXPECT_TRUE(original.getAcc(original_time).isApprox(
+        partial.getAcc(partial_time), 1e-10));
+    EXPECT_TRUE(original.getJer(original_time).isApprox(
+        partial.getJer(partial_time), 1e-10));
+}
+
+}  // namespace
+
+TEST(TrajectoryPartial, CutsLinearPrealignmentHold) {
+    const auto original = makeMixedOrderTrajectory();
+    geometry_utils::Trajectory partial;
+    ASSERT_TRUE(original.getPartialTrajectoryByTime(0.2, 1.2, partial));
+    EXPECT_NEAR(partial.getTotalDuration(), 1.0, 1e-12);
+    EXPECT_NEAR(partial.start_WT, 10.2, 1e-12);
+    expectSameState(original, partial, 0.2, 0.0);
+    expectSameState(original, partial, 1.2, 1.0);
+}
+
+TEST(TrajectoryPartial, CutsAcrossLinearAndCubicPieces) {
+    const auto original = makeMixedOrderTrajectory();
+    geometry_utils::Trajectory partial;
+    ASSERT_TRUE(original.getPartialTrajectoryByTime(1.0, 2.75, partial));
+    EXPECT_NEAR(partial.getTotalDuration(), 1.75, 1e-12);
+    EXPECT_NEAR(partial.start_WT, 11.0, 1e-12);
+    for (double dt = 0.0; dt <= 1.75; dt += 0.125) {
+        expectSameState(original, partial, 1.0 + dt, dt);
+    }
+}
+
+TEST(TrajectoryPartial, CutsInsideCubicYawPiece) {
+    const auto original = makeMixedOrderTrajectory();
+    geometry_utils::Trajectory partial;
+    ASSERT_TRUE(original.getPartialTrajectoryByTime(1.75, 3.25, partial));
+    EXPECT_NEAR(partial.getTotalDuration(), 1.5, 1e-12);
+    for (double dt = 0.0; dt <= 1.5; dt += 0.125) {
+        expectSameState(original, partial, 1.75 + dt, dt);
+    }
+}
+
+TEST(TrajectoryPartial, PreservesSeventhOrderPositionPiece) {
+    const auto original = makeSeventhOrderTrajectory();
+    geometry_utils::Trajectory partial;
+    ASSERT_TRUE(original.getPartialTrajectoryByTime(0.37, 2.03, partial));
+    EXPECT_EQ(partial[0].getCoeffMat().cols(), 8);
+    EXPECT_NEAR(partial.getTotalDuration(), 1.66, 1e-12);
+    EXPECT_NEAR(partial.start_WT, 20.37, 1e-12);
+    for (double dt = 0.0; dt <= 1.66; dt += 0.083) {
+        expectSameState(original, partial, 0.37 + dt, dt);
+    }
+}
+
+TEST(TrajectoryPartial, RejectsInvalidBounds) {
+    const auto original = makeMixedOrderTrajectory();
+    geometry_utils::Trajectory partial;
+    EXPECT_FALSE(original.getPartialTrajectoryByTime(-0.1, 1.0, partial));
+    EXPECT_FALSE(original.getPartialTrajectoryByTime(1.0, 1.0, partial));
+    EXPECT_FALSE(original.getPartialTrajectoryByTime(1.0, 4.0, partial));
+}
+
+TEST(TrajectoryExecutionClock, RebasePreservesTrajectoryTimeState) {
+    auto position = makeSeventhOrderTrajectory();
+    auto yaw = makeMixedOrderTrajectory();
+    position.start_WT = 10.0;
+    yaw.start_WT = 10.0;
+
+    super_planner::ExpTraj exploration;
+    exploration.setTrajectory(10.0, position, yaw);
+    super_planner::CmdTraj command;
+    command.setTrajectory(exploration);
+    const auto before = command.getPos(0.37);
+
+    command.setStartWallTime(42.5);
+    const auto heartbeat = command.heartbeatSnapshot();
+    EXPECT_NEAR(heartbeat.start_wall_time, 42.5, 1e-12);
+    EXPECT_NEAR(command.posTraj().start_WT, 42.5, 1e-12);
+    EXPECT_NEAR(command.yawTraj().start_WT, 42.5, 1e-12);
+    EXPECT_TRUE(before.isApprox(command.getPos(0.37), 1e-12));
+}
+
+TEST(YawPrealignmentGuard, PreservesCommittedHoldUntilCompletion) {
+    EXPECT_TRUE(super_planner::preserveCommittedYawPrealignment(0.0, 7.42));
+    EXPECT_TRUE(super_planner::preserveCommittedYawPrealignment(1.0, 7.42));
+    EXPECT_TRUE(super_planner::preserveCommittedYawPrealignment(7.418, 7.42));
+    EXPECT_FALSE(super_planner::preserveCommittedYawPrealignment(7.419, 7.42));
+    EXPECT_FALSE(super_planner::preserveCommittedYawPrealignment(7.42, 7.42));
+}
+
+TEST(YawPrealignmentGuard, RejectsInvalidOrInactiveClocks) {
+    EXPECT_FALSE(super_planner::preserveCommittedYawPrealignment(-0.1, 7.42));
+    EXPECT_FALSE(super_planner::preserveCommittedYawPrealignment(0.1, 0.0));
+    EXPECT_FALSE(super_planner::preserveCommittedYawPrealignment(
+        std::numeric_limits<double>::quiet_NaN(), 7.42));
+    EXPECT_FALSE(super_planner::preserveCommittedYawPrealignment(
+        0.1, std::numeric_limits<double>::infinity()));
+}
+
+int main(int argc, char** argv) {
+    ::testing::InitGoogleTest(&argc, argv);
+    return RUN_ALL_TESTS();
+}
diff --git a/super_planner/test/yaw_rate_limit_test.cpp b/super_planner/test/yaw_rate_limit_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c551c51976ea4ec5ad5708bd356913d4216be04d
--- /dev/null
+++ b/super_planner/test/yaw_rate_limit_test.cpp
@@ -0,0 +1,145 @@
+#include <gtest/gtest.h>
+
+#include <cmath>
+
+#include <traj_opt/yaw_traj_opt.h>
+
+namespace {
+
+geometry_utils::Trajectory makeRightAnglePositionTrajectory() {
+    geometry_utils::Trajectory position;
+    Eigen::MatrixXd outbound = Eigen::MatrixXd::Zero(3, 2);
+    outbound(0, 0) = 1.0;  // x=t
+    position.emplace_back(2.0, outbound);
+    Eigen::MatrixXd turn = Eigen::MatrixXd::Zero(3, 2);
+    turn(1, 0) = 1.0;      // y=t
+    turn(0, 1) = 2.0;      // x=2
+    position.emplace_back(2.0, turn);
+    return position;
+}
+
+geometry_utils::Trajectory makeLatestFlightBendTrajectory() {
+    // First moving piece from 2026-10-24 flight id307.  This is the path on
+    // which the old 0.2 s global interpolation attenuated the complete yaw
+    // profile: at t=10 s the tangent was about -19 deg while commanded yaw
+    // was still about -44 deg.
+    geometry_utils::Trajectory position;
+    Eigen::MatrixXd coefficients = Eigen::MatrixXd::Zero(3, 8);
+    coefficients.row(0) <<
+        -4.880510138304843e-09, 1.2880969243161826e-06,
+        -5.240895586288656e-05, 6.092446517107943e-04,
+        0.0, 0.0, 0.0, -3.008647568767139e-02;
+    coefficients.row(1) <<
+        1.1480424166761521e-07, -6.7455799542094545e-06,
+        1.3452702275804069e-04, -9.165296476443253e-04,
+        0.0, 0.0, 0.0, 5.0593408206527454e-02;
+    coefficients(2, 7) = 0.8323356189258312;
+    position.emplace_back(13.763496258764185, coefficients);
+    return position;
+}
+
+}  // namespace
+
+TEST(YawRateLimit, ClipsHalfTurnToFitShortPositionLeg) {
+    geometry_utils::Trajectory position;
+    Eigen::MatrixXd coefficients = Eigen::MatrixXd::Zero(3, 4);
+    coefficients(0, 2) = 0.8;
+    position.emplace_back(3.0, coefficients);
+
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    requested(0) = M_PI;
+    geometry_utils::Trajectory yaw;
+    traj_opt::YawTrajOpt optimizer(0.6);
+
+    ASSERT_TRUE(optimizer.optimize(initial, requested, position, yaw,
+                                   3, false, false));
+    EXPECT_LE(yaw.getMaxVelRate(), 0.6001);
+    EXPECT_GT(yaw.getPos(3.0).x(), 0.0);
+    EXPECT_LT(yaw.getPos(3.0).x(), M_PI);
+}
+
+TEST(YawRateLimit, VeryShortReturnLegStillProducesABoundedCommand) {
+    geometry_utils::Trajectory position;
+    Eigen::MatrixXd coefficients = Eigen::MatrixXd::Zero(3, 4);
+    coefficients(0, 2) = 0.8;
+    position.emplace_back(0.02, coefficients);
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    requested(0) = M_PI;
+    geometry_utils::Trajectory yaw;
+    traj_opt::YawTrajOpt optimizer(0.6);
+    ASSERT_TRUE(optimizer.optimize(initial, requested, position, yaw,
+                                   3, false, false));
+    EXPECT_LE(yaw.getMaxVelRate(), 0.6001);
+    EXPECT_GE(yaw.getPos(0.02).x(), 0.0);
+    EXPECT_LT(yaw.getPos(0.02).x(), M_PI);
+}
+
+TEST(YawRateLimit, ShortCurvedLegGetsInteriorTangentWaypoints) {
+    const geometry_utils::Trajectory position =
+        makeRightAnglePositionTrajectory();
+    traj_opt::YawTrajOpt optimizer(0.6, 0.5);
+    super_utils::VecDf times;
+    optimizer.getYawTimeAllocation(position.getTotalDuration(), times);
+    ASSERT_EQ(times.size(), 8);
+    EXPECT_NEAR(times.sum(), position.getTotalDuration(), 1e-9);
+
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    requested(0) = M_PI_2;
+    super_utils::VecDf waypoints;
+    optimizer.getYawWaypointAllocation(initial, requested, waypoints, times,
+                                       position);
+    ASSERT_EQ(waypoints.size(), 7);
+    EXPECT_NEAR(waypoints(0), 0.0, 1e-6);
+    EXPECT_NEAR(waypoints(1), 0.0, 1e-6);
+    EXPECT_GT(waypoints(3), 0.5);
+    EXPECT_LT(waypoints(3), M_PI_2);
+    EXPECT_NEAR(waypoints(6), M_PI_2, 1e-6);
+}
+
+TEST(YawRateLimit, CurvedLegTracksTurnWhileRespectingRateLimit) {
+    const geometry_utils::Trajectory position =
+        makeRightAnglePositionTrajectory();
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    requested(0) = M_PI_2;
+    geometry_utils::Trajectory yaw;
+    traj_opt::YawTrajOpt optimizer(0.6, 0.5);
+    ASSERT_TRUE(optimizer.optimize(initial, requested, position, yaw,
+                                   3, false, false));
+    EXPECT_LE(yaw.getMaxVelRate(), 0.6001);
+    EXPECT_GT(yaw.getPos(2.0).x(), yaw.getPos(0.5).x() + 0.05);
+    EXPECT_GT(yaw.getPos(3.0).x(), yaw.getPos(2.0).x());
+}
+
+TEST(YawRateLimit, LatestFlightBendKeepsYawNearVelocityTangent) {
+    const geometry_utils::Trajectory position =
+        makeLatestFlightBendTrajectory();
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    initial(0) = -0.851047065727122;
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    requested(0) = -0.17627825445142728;
+    geometry_utils::Trajectory yaw;
+    // Production requested 0.2 s knots on this 13.8 s leg.  The optimizer
+    // must cap the global system size without losing tangent tracking.
+    traj_opt::YawTrajOpt optimizer(0.6, 0.2);
+    ASSERT_TRUE(optimizer.optimize(initial, requested, position, yaw,
+                                   3, false, false));
+    EXPECT_LE(yaw.getMaxVelRate(), 0.6001);
+    for (double t = 3.0; t <= 12.0; t += 0.5) {
+        const auto velocity = position.getVel(t);
+        ASSERT_GT(velocity.head<2>().norm(), 0.05);
+        const double tangent = std::atan2(velocity.y(), velocity.x());
+        const double error = std::atan2(
+            std::sin(yaw.getPos(t).x() - tangent),
+            std::cos(yaw.getPos(t).x() - tangent));
+        EXPECT_LT(std::abs(error), 0.14) << "t=" << t;
+    }
+}
+
+int main(int argc, char** argv) {
+    ::testing::InitGoogleTest(&argc, argv);
+    return RUN_ALL_TESTS();
+}
