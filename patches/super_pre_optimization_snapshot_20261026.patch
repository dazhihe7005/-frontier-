diff --git a/super_planner/include/path_search/lateral_bypass_policy.h b/super_planner/include/path_search/lateral_bypass_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..1a393314d12b8e91913aa6905a7e25fd38f60919
--- /dev/null
+++ b/super_planner/include/path_search/lateral_bypass_policy.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include <Eigen/Dense>
+
+namespace path_search {
+
+// Geometry-only policy used by A*: first keep the route close to the
+// start-to-goal height profile so obstacles are passed on the left or right.
+// Later searches separately admit points above and below that profile.  This
+// keeps the required left/right -> up -> down priority deterministic and
+// unit-testable without coupling the policy to a particular map.
+class LateralBypassPolicy {
+public:
+    enum class SearchPhase {
+        LATERAL,
+        UPWARD,
+        DOWNWARD,
+        UNRESTRICTED,
+    };
+
+    LateralBypassPolicy(bool enabled,
+                        double vertical_band,
+                        double min_horizontal_span,
+                        double vertical_motion_cost)
+        : enabled_(enabled),
+          vertical_band_(vertical_band),
+          min_horizontal_span_(min_horizontal_span),
+          vertical_motion_cost_(vertical_motion_cost) {}
+
+    bool applies(const Eigen::Vector3d& start,
+                 const Eigen::Vector3d& goal) const {
+        return enabled_ &&
+               (goal.head<2>() - start.head<2>()).norm() >=
+                   min_horizontal_span_;
+    }
+
+    double referenceHeight(const Eigen::Vector3d& point,
+                           const Eigen::Vector3d& start,
+                           const Eigen::Vector3d& goal) const {
+        const Eigen::Vector2d direction =
+            goal.head<2>() - start.head<2>();
+        const double squared_span = direction.squaredNorm();
+        if (squared_span <= 1.0e-12) return start.z();
+
+        const double raw_progress =
+            (point.head<2>() - start.head<2>()).dot(direction) /
+            squared_span;
+        const double progress = std::max(0.0, std::min(1.0, raw_progress));
+        return start.z() + progress * (goal.z() - start.z());
+    }
+
+    bool allows(const Eigen::Vector3d& point,
+                const Eigen::Vector3d& start,
+                const Eigen::Vector3d& goal,
+                SearchPhase phase) const {
+        if (!applies(start, goal)) return true;
+        const double height_error =
+            point.z() - referenceHeight(point, start, goal);
+        switch (phase) {
+            case SearchPhase::LATERAL:
+                return std::abs(height_error) <= vertical_band_ + 1.0e-9;
+            case SearchPhase::UPWARD:
+                return height_error >= -vertical_band_ - 1.0e-9;
+            case SearchPhase::DOWNWARD:
+                return height_error <= vertical_band_ + 1.0e-9;
+            case SearchPhase::UNRESTRICTED:
+                return true;
+        }
+        return false;
+    }
+
+    double stepCost(int dx, int dy, int dz) const {
+        const double weighted_dz = vertical_motion_cost_ * dz;
+        return std::sqrt(dx * dx + dy * dy + weighted_dz * weighted_dz);
+    }
+
+private:
+    bool enabled_;
+    double vertical_band_;
+    double min_horizontal_span_;
+    double vertical_motion_cost_;
+};
+
+}  // namespace path_search
