+                            "rejecting goal {} so the explorer can choose a "
+                            "fresh route from current odometry.",
+                            consecutive_replan_failures_, token.goal_id);
+                    ChangeState("ReplanTimerCallback", WAIT_GOAL);
+                    gi_.new_goal = false;
+                    plan_from_rest_ = false;
+                    finish_plan = true;
+                    if (reject_failed_goal) *reject_failed_goal = true;
+                }
+                return;
+            }
+            consecutive_replan_failures_ = 0;
+            if (result == EMER) ChangeState("ReplanTimerCallback", EMER_STOP);
+            else if (result == NEW_TRAJ) ChangeState("ReplanTimerCallback", GENERATE_TRAJ);
