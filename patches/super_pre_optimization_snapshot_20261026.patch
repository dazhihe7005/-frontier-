diff --git a/super_planner/include/super_core/yaw_prealignment_guard.h b/super_planner/include/super_core/yaw_prealignment_guard.h
new file mode 100644
index 0000000000000000000000000000000000000000..4939a10e2c19a63066227af34803e53609820bcf
--- /dev/null
+++ b/super_planner/include/super_core/yaw_prealignment_guard.h
@@ -0,0 +1,24 @@
+#ifndef SUPER_PLANNER_YAW_PREALIGNMENT_GUARD_H
+#define SUPER_PLANNER_YAW_PREALIGNMENT_GUARD_H
+
+#include <cmath>
+
+namespace super_planner {
+
+// A rest-to-rest plan can deliberately hold position while yaw aligns with
+// the first path tangent.  Periodic replanning must preserve that committed
+// segment until its execution clock reaches the end of the hold.
+inline bool preserveCommittedYawPrealignment(
+    double trajectory_time, double prealignment_duration,
+    double completion_tolerance = 1e-3) {
+  return std::isfinite(trajectory_time) &&
+         std::isfinite(prealignment_duration) &&
+         std::isfinite(completion_tolerance) &&
+         prealignment_duration > 0.0 && completion_tolerance >= 0.0 &&
+         trajectory_time >= 0.0 &&
+         trajectory_time < prealignment_duration - completion_tolerance;
+}
+
+}  // namespace super_planner
+
+#endif  // SUPER_PLANNER_YAW_PREALIGNMENT_GUARD_H
