@@ -0,0 +1,76 @@
+#include <gtest/gtest.h>
+
+#include <super_core/horizontal_cylinder_safety.h>
+
+namespace {
+
+using super_planner::firstHorizontalCylinderViolation;
+using super_planner::firstPrematureCenterReturn;
+using super_utils::vec_E;
+
+TEST(HorizontalCylinderSafety, ClimbCannotCompensateInsideVerticalEnvelope) {
+    vec_E<Eigen::Vector3d> trajectory{{0.6, 0.0, 0.5}};
+    vec_E<Eigen::Vector3d> obstacles{{0.0, 0.0, 0.05}};
+    const auto result = firstHorizontalCylinderViolation(
+        trajectory, obstacles, 0.8, 0.5, 0.5);
+    ASSERT_TRUE(result.violated);
+    EXPECT_NEAR(result.horizontal_distance, 0.6, 1.0e-9);
+    EXPECT_NEAR(result.vertical_distance, 0.45, 1.0e-9);
+}
+
+TEST(HorizontalCylinderSafety, ObstacleAboveCylinderDoesNotBlock) {
+    vec_E<Eigen::Vector3d> trajectory{{0.0, 0.0, 0.0}};
+    vec_E<Eigen::Vector3d> obstacles{{0.0, 0.0, 1.1}};
+    EXPECT_FALSE(firstHorizontalCylinderViolation(
+        trajectory, obstacles, 0.8, 0.5, 0.5).violated);
+}
+
+TEST(HorizontalCylinderSafety, GroundPlaneCanBeExcludedWithoutWeakeningRadius) {
+    vec_E<Eigen::Vector3d> trajectory{{0.0, 0.0, 0.5}};
+    vec_E<Eigen::Vector3d> ground{{0.2, 0.0, -0.05}};
+    EXPECT_FALSE(firstHorizontalCylinderViolation(
+        trajectory, ground, 0.8, 0.5, 0.5, 0.0).violated);
+
+    vec_E<Eigen::Vector3d> obstacle_top{{0.6, 0.0, 0.05}};
+    EXPECT_TRUE(firstHorizontalCylinderViolation(
+        trajectory, obstacle_top, 0.8, 0.5, 0.5, 0.0).violated);
+}
+
+TEST(HorizontalCylinderSafety, RejectsReturnBeforeFarObstacleEdge) {
+    vec_E<Eigen::Vector3d> obstacles{
+        {4.4, 0.5, 0.0}, {4.6, 0.9, 0.0}};
+    vec_E<Eigen::Vector3d> trajectory{
+        {0.0, 0.0, 0.5}, {3.5, -0.4, 0.5},
+        {4.0, -0.1, 0.5}, {5.0, 0.0, 0.5}};
+    const auto result = firstPrematureCenterReturn(
+        trajectory, obstacles, {0.0, 0.0, 0.5}, {5.0, 0.0, 0.5},
+        0.8, 0.5, 0.5, 1.2);
+    ASSERT_TRUE(result.violated);
+    EXPECT_FALSE(result.bypass_on_left);
+    EXPECT_NEAR(result.required_lateral, -0.3, 1.0e-9);
+}
+
+TEST(HorizontalCylinderSafety, AllowsReturnAfterFarObstacleEdge) {
+    vec_E<Eigen::Vector3d> obstacles{
+        {4.0, 0.5, 0.0}, {4.2, 0.9, 0.0}};
+    vec_E<Eigen::Vector3d> trajectory{
+        {0.0, 0.0, 0.5}, {3.2, -0.4, 0.5},
+        {4.9, -0.4, 0.5}, {5.1, 0.0, 0.5}};
+    EXPECT_FALSE(firstPrematureCenterReturn(
+        trajectory, obstacles, {0.0, 0.0, 0.5}, {5.1, 0.0, 0.5},
+        0.8, 0.5, 0.5, 1.2).violated);
+}
+
+TEST(HorizontalCylinderSafety, UsesPointFiveBelowAndAbove) {
+    vec_E<Eigen::Vector3d> trajectory{{0.0, 0.0, 0.0}};
+    EXPECT_TRUE(firstHorizontalCylinderViolation(
+        trajectory, {{0.6, 0.0, -0.49}}, 0.8, 0.5, 0.5).violated);
+    EXPECT_FALSE(firstHorizontalCylinderViolation(
+        trajectory, {{0.6, 0.0, -0.501}}, 0.8, 0.5, 0.5).violated);
+    EXPECT_TRUE(firstHorizontalCylinderViolation(
+        trajectory, {{0.6, 0.0, 0.49}}, 0.8, 0.5, 0.5).violated);
+    EXPECT_FALSE(firstHorizontalCylinderViolation(
+        trajectory, {{0.6, 0.0, 0.501}}, 0.8, 0.5, 0.5).violated);
+}
+
+}  // namespace
diff --git a/super_planner/test/lateral_bypass_policy_test.cpp b/super_planner/test/lateral_bypass_policy_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8ffeb3f8f9928c64aa3f7310f22793f099b97222
--- /dev/null
+++ b/super_planner/test/lateral_bypass_policy_test.cpp
@@ -0,0 +1,63 @@
+#include <gtest/gtest.h>
+
+#include <path_search/lateral_bypass_policy.h>
+
+namespace {
+
+using path_search::LateralBypassPolicy;
+using SearchPhase = LateralBypassPolicy::SearchPhase;
+
+TEST(LateralBypassPolicy, LateralPassStaysNearSlopedHeightProfile) {
+    LateralBypassPolicy policy(true, 0.15, 1.0, 2.0);
+    const Eigen::Vector3d start(0.0, 0.0, 0.5);
+    const Eigen::Vector3d goal(5.0, 0.0, 1.0);
+
+    EXPECT_TRUE(policy.applies(start, goal));
+    EXPECT_NEAR(policy.referenceHeight(Eigen::Vector3d(2.5, 1.0, 9.0),
+                                       start, goal),
+                0.75, 1.0e-9);
+    EXPECT_TRUE(policy.allows(Eigen::Vector3d(2.5, 1.0, 0.88),
+                              start, goal, SearchPhase::LATERAL));
+    EXPECT_FALSE(policy.allows(Eigen::Vector3d(2.5, 1.0, 1.10),
+                               start, goal, SearchPhase::LATERAL));
+}
+
+TEST(LateralBypassPolicy, UpwardFallbackAllowsClimbButRejectsDive) {
+    LateralBypassPolicy policy(true, 0.15, 1.0, 2.0);
+    const Eigen::Vector3d start(0.0, 0.0, 0.5);
+    const Eigen::Vector3d goal(5.0, 0.0, 0.5);
+
+    EXPECT_TRUE(policy.allows(Eigen::Vector3d(2.5, 0.0, 1.2),
+                              start, goal, SearchPhase::UPWARD));
+    EXPECT_FALSE(policy.allows(Eigen::Vector3d(2.5, 0.0, 0.2),
+                               start, goal, SearchPhase::UPWARD));
+}
+
+TEST(LateralBypassPolicy, DownwardFallbackAllowsDiveButRejectsClimb) {
+    LateralBypassPolicy policy(true, 0.15, 1.0, 2.0);
+    const Eigen::Vector3d start(0.0, 0.0, 0.5);
+    const Eigen::Vector3d goal(5.0, 0.0, 0.5);
+
+    EXPECT_TRUE(policy.allows(Eigen::Vector3d(2.5, 0.0, 0.2),
+                              start, goal, SearchPhase::DOWNWARD));
+    EXPECT_FALSE(policy.allows(Eigen::Vector3d(2.5, 0.0, 1.2),
+                               start, goal, SearchPhase::DOWNWARD));
+}
+
+TEST(LateralBypassPolicy, VerticalMotionCostsMoreThanLateralMotion) {
+    LateralBypassPolicy policy(true, 0.15, 1.0, 2.0);
+    EXPECT_DOUBLE_EQ(policy.stepCost(0, 1, 0), 1.0);
+    EXPECT_DOUBLE_EQ(policy.stepCost(0, 0, 1), 2.0);
+    EXPECT_GT(policy.stepCost(1, 0, 1), policy.stepCost(1, 1, 0));
+}
+
+TEST(LateralBypassPolicy, PureVerticalMissionDoesNotUseLateralPriority) {
+    LateralBypassPolicy policy(true, 0.15, 1.0, 2.0);
+    const Eigen::Vector3d start(0.0, 0.0, 0.5);
+    const Eigen::Vector3d goal(0.2, 0.1, 5.0);
+    EXPECT_FALSE(policy.applies(start, goal));
+    EXPECT_TRUE(policy.allows(Eigen::Vector3d(0.0, 0.0, -1.0),
+                              start, goal, SearchPhase::LATERAL));
+}
+
+}  // namespace
