diff --git a/super_planner/include/super_core/flight_z_contract.h b/super_planner/include/super_core/flight_z_contract.h
new file mode 100644
index 0000000000000000000000000000000000000000..be1484ce6adceb6c08fe18a57c13fa45e642028a
--- /dev/null
+++ b/super_planner/include/super_core/flight_z_contract.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include <data_structure/base/trajectory.h>
+
+namespace super_planner {
+
+inline double binomial(int n, int k) {
+    double result = 1.0;
+    for (int i = 1; i <= k; ++i) {
+        result *= static_cast<double>(n - k + i) / i;
+    }
+    return result;
+}
+
+inline bool bernsteinInside(const std::vector<double>& controls,
+                            double min_z, double max_z, int depth) {
+    constexpr double kRoundoff = 1e-9;
+    if (std::all_of(controls.begin(), controls.end(), [&](double value) {
+            return std::isfinite(value) && value >= min_z - kRoundoff &&
+                   value <= max_z + kRoundoff;
+        })) return true;
+    if (controls.front() < min_z - kRoundoff || controls.front() > max_z + kRoundoff ||
+        controls.back() < min_z - kRoundoff || controls.back() > max_z + kRoundoff ||
+        depth == 0) return false;
+
+    // de Casteljau subdivision. Each child control hull still encloses the
+    // entire polynomial over its half-interval; no time sampling is assumed.
+    const int n = static_cast<int>(controls.size());
+    std::vector<double> left(n), right(n), row = controls;
+    left[0] = row[0];
+    right[n - 1] = row[n - 1];
+    for (int level = 1; level < n; ++level) {
+        for (int i = 0; i < n - level; ++i) {
+            row[i] = 0.5 * (row[i] + row[i + 1]);
+        }
+        left[level] = row[0];
+        right[n - level - 1] = row[n - level - 1];
+    }
+    return bernsteinInside(left, min_z, max_z, depth - 1) &&
+           bernsteinInside(right, min_z, max_z, depth - 1);
+}
+
+inline bool polynomialInsideFlightZ(const Eigen::MatrixXd& matrix,
+                                    double duration, double min_z,
+                                    double max_z) {
+    const int n = static_cast<int>(matrix.cols()) - 1;
+    if (!(std::isfinite(min_z) && std::isfinite(max_z) && min_z < max_z) ||
+        matrix.rows() < 3 || n < 0 || n > 20 ||
+        !std::isfinite(duration) || duration <= 0.0) return false;
+    std::vector<double> controls(n + 1, 0.0);
+    double time_power = 1.0;
+    for (int j = 0; j <= n; ++j) {
+        const double power_coefficient = matrix(2, n - j) * time_power;
+        if (!std::isfinite(power_coefficient)) return false;
+        for (int k = j; k <= n; ++k) {
+            controls[k] += power_coefficient * binomial(k, j) /
+                           binomial(n, j);
+        }
+        time_power *= duration;
+    }
+    if (!std::all_of(controls.begin(), controls.end(),
+                     [](double value) { return std::isfinite(value); })) return false;
+    return bernsteinInside(controls, min_z, max_z, 14);
+}
+
+inline bool trajectoryInsideFlightZ(const geometry_utils::Trajectory& trajectory,
+                                    double min_z, double max_z) {
+    if (trajectory.empty()) return false;
+    for (const auto& piece : trajectory) {
+        if (!polynomialInsideFlightZ(piece.getCoeffMat(), piece.getDuration(),
+                                     min_z, max_z)) return false;
+    }
+    return true;
+}
+
+}  // namespace super_planner
diff --git a/super_planner/include/super_core/horizontal_clearance_contract.h b/super_planner/include/super_core/horizontal_clearance_contract.h
new file mode 100644
index 0000000000000000000000000000000000000000..ce51a14824d50b53d6f89b7b22a8631fb1bf9ffa
--- /dev/null
+++ b/super_planner/include/super_core/horizontal_clearance_contract.h
@@ -0,0 +1,123 @@
+#pragma once
+
+#include <cmath>
+#include <algorithm>
+#include <Eigen/Core>
+
+namespace super_planner {
+
+// Every sample inside the preferred-clearance envelope pays a soft preference
+// penalty. A second, proximity-dependent term grades the fallback
+// band from 1x at the preferred boundary to 2x at the hard boundary.
+inline double preferredClearancePenaltyMultiplier(
+    double nearest_occupied_offset_steps,
+    double preferred_margin_steps) {
+    if (!std::isfinite(nearest_occupied_offset_steps)) return 0.0;
+    if (!std::isfinite(preferred_margin_steps) ||
+        preferred_margin_steps <= 0.0 ||
+        nearest_occupied_offset_steps > preferred_margin_steps + 1e-9) {
+        return 0.0;
+    }
+    // The current A* cell is already outside the hard-inflated obstacle, so
+    // one grid cell is the closest representable safe layer.
+    const double graded_span = std::max(preferred_margin_steps - 1.0, 1.0);
+    const double proximity = std::clamp(
+        (preferred_margin_steps - nearest_occupied_offset_steps) /
+            graded_span,
+        0.0, 1.0);
+    return 1.0 + proximity;
+}
+
+// Preferred clearance is a comfort/reward term, not a second collision
+// boundary.  Bound its contribution per A* step so a long route through the
+// preferred envelope cannot beat a shorter route that still satisfies the
+// hard planning clearance.  This also prevents the search from walking back
+// through explored space merely to avoid the fallback band.
+inline double explorationFirstPreferredClearancePenalty(
+    double step_cost, double configured_penalty, double multiplier) {
+    if (!std::isfinite(step_cost) || step_cost <= 0.0 ||
+        !std::isfinite(configured_penalty) || configured_penalty <= 0.0 ||
+        !std::isfinite(multiplier) || multiplier <= 0.0) {
+        return 0.0;
+    }
+    return std::min(configured_penalty * multiplier, 0.5 * step_cost);
+}
+
+// A horizon-limited exploration path must make real progress toward its
+// target.  Reaching the distance budget alone is not success: without this
+// guard A* can return a seven-metre path in the opposite direction when a
+// preferred-clearance penalty makes the forward fallback band expensive.
+inline bool horizonEndpointMakesGoalProgress(
+    const Eigen::Vector3d& start, const Eigen::Vector3d& goal,
+    const Eigen::Vector3d& endpoint, double resolution) {
+    if (!start.allFinite() || !goal.allFinite() || !endpoint.allFinite() ||
+        !std::isfinite(resolution) || resolution <= 0.0) {
+        return false;
+    }
+    const Eigen::Vector3d goal_delta = goal - start;
+    const double start_distance = goal_delta.norm();
+    if (start_distance <= resolution) return true;
+    const double forward_progress =
+        (endpoint - start).dot(goal_delta / start_distance);
+    const double endpoint_distance = (goal - endpoint).norm();
+    return forward_progress >= 0.5 * resolution &&
+           endpoint_distance <= start_distance - 0.25 * resolution;
+}
+
+// Inset only an obstacle half-space.  The support function of a horizontal
+// disk of radius extra is extra * ||n_xy||; vertical flight bounds are not
+// contracted.  An infeasible seed is rejected before optimization.
+inline bool insetObstaclePlaneHorizontal(
+    const Eigen::Vector4d& plane, double extra,
+    const Eigen::Vector3d& start, const Eigen::Vector3d& end,
+    Eigen::Vector4d& inset) {
+    if (!plane.allFinite() || !start.allFinite() || !end.allFinite() ||
+        !std::isfinite(extra) || extra < 0.0) return false;
+    inset = plane;
+    inset(3) += extra * plane.head<2>().norm();
+    if (!inset.allFinite()) return false;
+    return inset.head<3>().dot(start) + inset(3) <= 1e-8 &&
+           inset.head<3>().dot(end) + inset(3) <= 1e-8;
+}
+
+// CIRI's ellipsoid tangent is not necessarily normal to the closest point on
+// the seed segment.  Translating that arbitrary plane by the additional
+// horizontal clearance can therefore cut an otherwise valid seed.  Build the
+// exact supporting half-space of the requested horizontal obstacle cylinder
+// as a conservative fallback.  The returned plane contains the complete seed
+// segment and places the obstacle point `clearance` metres outside it.
+inline bool horizontalClearancePlaneForSeed(
+    const Eigen::Vector3d& obstacle, double clearance,
+    const Eigen::Vector3d& start, const Eigen::Vector3d& end,
+    Eigen::Vector4d& plane) {
+    if (!obstacle.allFinite() || !start.allFinite() || !end.allFinite() ||
+        !std::isfinite(clearance) || clearance <= 0.0) return false;
+
+    const Eigen::Vector2d start_xy = start.head<2>();
+    const Eigen::Vector2d end_xy = end.head<2>();
+    const Eigen::Vector2d obstacle_xy = obstacle.head<2>();
+    const Eigen::Vector2d segment = end_xy - start_xy;
+    const double segment_squared = segment.squaredNorm();
+    double t = 0.0;
+    if (segment_squared > 1e-12) {
+        t = std::clamp(
+            (obstacle_xy - start_xy).dot(segment) / segment_squared,
+            0.0, 1.0);
+    }
+    const Eigen::Vector2d closest = start_xy + t * segment;
+    const Eigen::Vector2d obstacle_from_seed = obstacle_xy - closest;
+    const double distance = obstacle_from_seed.norm();
+    if (!std::isfinite(distance) || distance < clearance - 1e-8 ||
+        distance < 1e-9) return false;
+
+    const Eigen::Vector2d normal = obstacle_from_seed / distance;
+    plane << normal.x(), normal.y(), 0.0,
+        -normal.dot(obstacle_xy) + clearance;
+    if (!plane.allFinite()) return false;
+    return plane.head<3>().dot(start) + plane(3) <= 1e-8 &&
+           plane.head<3>().dot(end) + plane(3) <= 1e-8 &&
+           plane.head<3>().dot(obstacle) + plane(3) >=
+               clearance - 1e-8;
+}
+
+}  // namespace super_planner
diff --git a/super_planner/include/super_core/horizontal_cylinder_safety.h b/super_planner/include/super_core/horizontal_cylinder_safety.h
new file mode 100644
index 0000000000000000000000000000000000000000..57755624021378187674848deac71c26a1f7871c
--- /dev/null
+++ b/super_planner/include/super_core/horizontal_cylinder_safety.h
@@ -0,0 +1,183 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include <Eigen/Core>
+#include <utils/header/type_utils.hpp>
+
+namespace super_planner {
+
+struct HorizontalCylinderViolation {
+    bool violated{false};
+    Eigen::Vector3d trajectory_point{Eigen::Vector3d::Zero()};
+    Eigen::Vector3d obstacle_point{Eigen::Vector3d::Zero()};
+    double horizontal_distance{std::numeric_limits<double>::infinity()};
+    double vertical_distance{std::numeric_limits<double>::infinity()};
+};
+
+// A finite-height vertical cylinder is deliberate: horizontal and vertical
+// separation are checked independently, so climbing within the vehicle's
+// vertical envelope can never compensate for insufficient XY clearance.
+inline HorizontalCylinderViolation firstHorizontalCylinderViolation(
+        const super_utils::vec_E<Eigen::Vector3d>& trajectory,
+        const super_utils::vec_E<Eigen::Vector3d>& obstacles,
+        double horizontal_radius,
+        double vertical_clearance_below,
+        double vertical_clearance_above,
+        double min_obstacle_z = -std::numeric_limits<double>::infinity()) {
+    HorizontalCylinderViolation result;
+    if (!(std::isfinite(horizontal_radius) && horizontal_radius > 0.0 &&
+          std::isfinite(vertical_clearance_below) &&
+          vertical_clearance_below > 0.0 &&
+          std::isfinite(vertical_clearance_above) &&
+          vertical_clearance_above > 0.0)) {
+        result.violated = true;
+        return result;
+    }
+    for (const auto& point : trajectory) {
+        if (!point.allFinite()) {
+            result.violated = true;
+            result.trajectory_point = point;
+            return result;
+        }
+        for (const auto& obstacle : obstacles) {
+            if (!obstacle.allFinite()) continue;
+            // Ground is a support plane, not a vertical keep-out cylinder.
+            // The threshold is expressed in the same gravity-aligned planning
+            // frame as the raw cloud, and must be configured below every
+            // obstacle surface that should participate in the hard guard.
+            if (obstacle.z() < min_obstacle_z) continue;
+            const double signed_dz = obstacle.z() - point.z();
+            if (signed_dz < -vertical_clearance_below - 1.0e-9 ||
+                signed_dz > vertical_clearance_above + 1.0e-9) continue;
+            const double dz = std::abs(signed_dz);
+            const double horizontal =
+                (point.head<2>() - obstacle.head<2>()).norm();
+            if (horizontal < horizontal_radius - 1.0e-9) {
+                result.violated = true;
+                result.trajectory_point = point;
+                result.obstacle_point = obstacle;
+                result.horizontal_distance = horizontal;
+                result.vertical_distance = dz;
+                return result;
+            }
+        }
+    }
+    return result;
+}
+
+struct CenterReturnViolation {
+    bool violated{false};
+    bool bypass_on_left{false};
+    Eigen::Vector3d trajectory_point{Eigen::Vector3d::Zero()};
+    double obstacle_begin{0.0};
+    double obstacle_end{0.0};
+    double required_lateral{0.0};
+    double actual_lateral{0.0};
+};
+
+// Treat centerline-blocking obstacle returns as one conservative envelope.
+// Once the candidate chooses a side, it must remain outside that obstacle's
+// lateral edge until its centre has passed the far edge plus the hard radius.
+// This intentionally forbids a circular "corner cut" back to the centreline.
+inline CenterReturnViolation firstPrematureCenterReturn(
+        const super_utils::vec_E<Eigen::Vector3d>& trajectory,
+        const super_utils::vec_E<Eigen::Vector3d>& obstacles,
+        const Eigen::Vector3d& route_start,
+        const Eigen::Vector3d& route_goal,
+        double horizontal_radius,
+        double vertical_clearance_below,
+        double vertical_clearance_above,
+        double centerline_obstacle_half_width,
+        double min_obstacle_z = -std::numeric_limits<double>::infinity()) {
+    CenterReturnViolation result;
+    const Eigen::Vector2d delta =
+        route_goal.head<2>() - route_start.head<2>();
+    const double length = delta.norm();
+    if (trajectory.empty() || obstacles.empty() || length < 1.0e-6 ||
+        horizontal_radius <= 0.0 || vertical_clearance_below <= 0.0 ||
+        vertical_clearance_above <= 0.0 ||
+        centerline_obstacle_half_width <= 0.0) return result;
+    const Eigen::Vector2d forward = delta / length;
+    const Eigen::Vector2d left(-forward.y(), forward.x());
+    const auto project = [&](const Eigen::Vector3d& p) {
+        const Eigen::Vector2d relative = p.head<2>() - route_start.head<2>();
+        return std::pair<double, double>(relative.dot(forward),
+                                         relative.dot(left));
+    };
+
+    double obstacle_begin = std::numeric_limits<double>::infinity();
+    double obstacle_end = -std::numeric_limits<double>::infinity();
+    double obstacle_left_min = std::numeric_limits<double>::infinity();
+    double obstacle_left_max = -std::numeric_limits<double>::infinity();
+    for (const auto& obstacle : obstacles) {
+        if (!obstacle.allFinite()) continue;
+        if (obstacle.z() < min_obstacle_z) continue;
+        const auto obstacle_sl = project(obstacle);
+        if (obstacle_sl.first < 0.0 || obstacle_sl.first > length ||
+            std::abs(obstacle_sl.second) > centerline_obstacle_half_width) {
+            continue;
+        }
+        bool vertically_relevant = false;
+        for (const auto& point : trajectory) {
+            const auto point_sl = project(point);
+            if (std::abs(point_sl.first - obstacle_sl.first) <=
+                horizontal_radius) {
+                const double signed_dz = obstacle.z() - point.z();
+                if (signed_dz >= -vertical_clearance_below - 1.0e-9 &&
+                    signed_dz <= vertical_clearance_above + 1.0e-9) {
+                    vertically_relevant = true;
+                    break;
+                }
+            }
+        }
+        if (!vertically_relevant) continue;
+        obstacle_begin = std::min(obstacle_begin, obstacle_sl.first);
+        obstacle_end = std::max(obstacle_end, obstacle_sl.first);
+        obstacle_left_min = std::min(obstacle_left_min, obstacle_sl.second);
+        obstacle_left_max = std::max(obstacle_left_max, obstacle_sl.second);
+    }
+    if (!std::isfinite(obstacle_begin)) return result;
+
+    const double obstacle_mid = 0.5 * (obstacle_begin + obstacle_end);
+    double selected_lateral = 0.0;
+    double selected_forward_error = std::numeric_limits<double>::infinity();
+    for (const auto& point : trajectory) {
+        const auto sl = project(point);
+        const double error = std::abs(sl.first - obstacle_mid);
+        if (error < selected_forward_error) {
+            selected_forward_error = error;
+            selected_lateral = sl.second;
+        }
+    }
+    const double obstacle_center =
+        0.5 * (obstacle_left_min + obstacle_left_max);
+    const bool bypass_on_left = selected_lateral > obstacle_center;
+    const double required_lateral = bypass_on_left
+        ? obstacle_left_max + horizontal_radius
+        : obstacle_left_min - horizontal_radius;
+    const double guarded_begin = obstacle_begin - horizontal_radius;
+    const double guarded_end = obstacle_end + horizontal_radius;
+    for (const auto& point : trajectory) {
+        const auto sl = project(point);
+        if (sl.first < guarded_begin || sl.first > guarded_end) continue;
+        const bool inside = bypass_on_left
+            ? sl.second < required_lateral - 1.0e-6
+            : sl.second > required_lateral + 1.0e-6;
+        if (inside) {
+            result.violated = true;
+            result.bypass_on_left = bypass_on_left;
+            result.trajectory_point = point;
+            result.obstacle_begin = obstacle_begin;
+            result.obstacle_end = obstacle_end;
+            result.required_lateral = required_lateral;
+            result.actual_lateral = sl.second;
+            return result;
+        }
+    }
+    return result;
+}
+
+}  // namespace super_planner
