+#include <gtest/gtest.h>
+#include <rog_map/rog_map_core/inflation_geometry.h>
+
+TEST(InflationGeometry, DefaultPreservesSphere) {
+    EXPECT_TRUE(rog_map::includeInflationOffset(2, 2, 1, 3, -1));
+    EXPECT_FALSE(rog_map::includeInflationOffset(3, 3, 0, 3, -1));
+}
+
+TEST(InflationGeometry, ExplicitVerticalExtentKeepsWallAndExcludesFarFloor) {
+    EXPECT_TRUE(rog_map::includeInflationOffset(7, 0, 2, 7, 2));
+    EXPECT_FALSE(rog_map::includeInflationOffset(7, 0, 3, 7, 2));
+    EXPECT_FALSE(rog_map::includeInflationOffset(6, 6, 0, 7, 2));
+}
+
+TEST(InflationGeometry, OneMetreProfileKeepsHorizontalAndLimitsVertical) {
+    // 0.1 m voxels: use a 1.3 m front-end horizontal search margin to absorb
+    // grid/diagonal quantization while limiting vertical inflation to 0.6 m.
+    EXPECT_TRUE(rog_map::includeInflationOffset(13, 0, 6, 13, 6));
+    EXPECT_FALSE(rog_map::includeInflationOffset(13, 0, 7, 13, 6));
+    EXPECT_FALSE(rog_map::includeInflationOffset(10, 10, 0, 13, 6));
+}
+
+TEST(InflationGeometry, HalfMetreVehicleEnvelopeAboveAndBelow) {
+    EXPECT_TRUE(rog_map::includeInflationOffset(9, 0, 5, 9, 5, 5));
+    EXPECT_FALSE(rog_map::includeInflationOffset(9, 0, 6, 9, 5, 5));
+    EXPECT_TRUE(rog_map::includeInflationOffset(9, 0, -5, 9, 5, 5));
+    EXPECT_FALSE(rog_map::includeInflationOffset(9, 0, -6, 9, 5, 5));
+}
