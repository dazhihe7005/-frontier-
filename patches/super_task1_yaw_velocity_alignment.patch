new file mode 100644
index 0000000..edf3860
--- /dev/null
+++ b/super_planner/include/super_core/yaw_velocity_alignment_guard.h
@@ -0,0 +1,59 @@
+#ifndef SUPER_PLANNER_YAW_VELOCITY_ALIGNMENT_GUARD_H
+#define SUPER_PLANNER_YAW_VELOCITY_ALIGNMENT_GUARD_H
+
+#include <algorithm>
+#include <cmath>
+
+#include <data_structure/base/trajectory.h>
+
+namespace super_planner {
+
+struct YawVelocityAlignment {
+    double max_error{0.0};
+    double time{0.0};
+    double speed{0.0};
+};
+
+// Inspect the *new moving part* of an exploration trajectory before commit.
+// An emergency backup may intentionally translate laterally and is not gated.
+inline YawVelocityAlignment measureYawVelocityAlignment(
+    const geometry_utils::Trajectory& position,
+    const geometry_utils::Trajectory& yaw,
+    double min_horizontal_speed, double sample_period = 0.1) {
+    YawVelocityAlignment result;
+    if (position.empty() || yaw.empty() || sample_period <= 0.0) {
+        result.max_error = INFINITY;
+        return result;
+    }
+    const double duration = position.getTotalDuration();
+    if (!std::isfinite(duration) ||
+        std::abs(duration - yaw.getTotalDuration()) > 1e-3) {
+        result.max_error = INFINITY;
+        return result;
+    }
+    const int samples = std::max(1, static_cast<int>(std::ceil(duration /
+                                                             sample_period)));
+    for (int i = 0; i <= samples; ++i) {
+        const double time = duration * static_cast<double>(i) / samples;
+        const auto velocity = position.getVel(time);
+        const double speed = std::hypot(velocity.x(), velocity.y());
+        if (speed < min_horizontal_speed) continue;
+        const double heading = std::atan2(velocity.y(), velocity.x());
+        const double yaw_command = yaw.getPos(time).x();
+        const double error = std::abs(std::atan2(
+            std::sin(heading - yaw_command),
+            std::cos(heading - yaw_command)));
+        if (!std::isfinite(error)) {
+            result.max_error = INFINITY;
+            return result;
+        }
+        if (error > result.max_error) {
+            result = {error, time, speed};
+        }
+    }
+    return result;
+}
+
+}  // namespace super_planner
+
+#endif  // SUPER_PLANNER_YAW_VELOCITY_ALIGNMENT_GUARD_H
