+        if (rate_limited_tangent_tracking_ && order == 3 && !free_start) {
+            // A global minimum-acceleration solve can contain one coefficient
+            // spike at a sharp turn. Scaling every waypoint to meet the rate
+            // limit then makes the nose nearly stationary for the whole leg.
+            // Follow the local tangent with bounded yaw rate and acceleration
+            // instead. Each piece starts at the preceding piece's yaw/rate.
+            Trajectory local_yaw;
+            double yaw = init_state(0);
+            double rate = init_state(1);
+            if (!std::isfinite(yaw) || !std::isfinite(rate) ||
+                std::abs(rate) > yaw_dot_max_ + 1e-3) {
+                return false;
+            }
+            constexpr double kYawAccelerationLimit = 1.0; // rad/s^2
+            constexpr double kHeadingResponseTime = 0.4; // s
+            for (long int i = 0; i < times.size(); ++i) {
+                const double duration = times(i);
+                const double requested =
+                    i < way_pts.size() ? way_pts(i) : goal_state(0);
+                double target = requested;
+                normalizeNextYaw(yaw, target);
+                const double desired_rate = std::max(
+                    -yaw_dot_max_, std::min(yaw_dot_max_,
+                                             (target - yaw) /
+                                                 kHeadingResponseTime));
+                const double next_rate = std::max(
+                    -yaw_dot_max_, std::min(yaw_dot_max_,
+                        std::max(rate - kYawAccelerationLimit * duration,
+                                 std::min(rate + kYawAccelerationLimit * duration,
+                                          desired_rate))));
+                const double acceleration = (next_rate - rate) / duration;
+                // Piece's trajectory math stores scalar yaw in a 3-row
+                // coefficient matrix (the unused rows must be zero).
+                Eigen::MatrixXd coefficients = Eigen::MatrixXd::Zero(3, 3);
+                coefficients(0, 0) = 0.5 * acceleration;
+                coefficients(0, 1) = rate;
+                coefficients(0, 2) = yaw;
+                local_yaw.emplace_back(duration, coefficients);
+                yaw += 0.5 * (rate + next_rate) * duration;
+                rate = next_rate;
+            }
+            out_traj = local_yaw;
