 #include "planner_common/map_manager_voxblox_impl.h"
 
+// A voxel cube may intersect the requested spherical envelope even when its
+// centre does not. The half-diagonal is deliberately conservative; this is
+// an occupancy-map test, not a certificate against unseen real geometry.
+template <typename SDFServerType, typename SDFVoxelType>
+typename MapManagerVoxblox<SDFServerType, SDFVoxelType>::VoxelStatus
+MapManagerVoxblox<SDFServerType, SDFVoxelType>::getCapsuleStatus(
+    const Eigen::Vector3d& start, const Eigen::Vector3d& end, double radius,
+    bool stop_at_unknown_voxel) const {
+  const double voxel_size = sdf_layer_->voxel_size();
+  const double voxel_size_inv = 1.0 / voxel_size;
+  const double expanded_radius = radius + 0.5 * std::sqrt(3.0) * voxel_size;
+  const double expanded_radius_sq = expanded_radius * expanded_radius;
+  // The legacy 1-voxel positive TSDF threshold plus the voxel half-diagonal
+  // margin would reject centres more than 1.3 m from a wall for a 1 m sphere.
+  // In this mode, treat the near-zero TSDF band as the surface; the voxel
+  // half-diagonal already accounts for where that surface lies in the cube.
+  const double occupancy_distance =
+      std::min<double>(occupancy_distance_voxelsize_factor_, 0.25) *
+          voxel_size + 1e-6;
+  const Eigen::Vector3d margin = Eigen::Vector3d::Constant(expanded_radius);
+  const Eigen::Vector3d lower = start.cwiseMin(end) - margin;
+  const Eigen::Vector3d upper = start.cwiseMax(end) + margin;
+  const voxblox::LongIndex first =
+      voxblox::getGridIndexFromPoint<voxblox::LongIndex>(
+          lower.cast<voxblox::FloatingPoint>(), voxel_size_inv);
+  const voxblox::LongIndex last =
+      voxblox::getGridIndexFromPoint<voxblox::LongIndex>(
+          upper.cast<voxblox::FloatingPoint>(), voxel_size_inv);
+  const Eigen::Vector3d segment = end - start;
+  const double segment_sq = segment.squaredNorm();
+  VoxelStatus status = VoxelStatus::kFree;
+  for (int64_t x = first.x(); x <= last.x(); ++x) {
+    for (int64_t y = first.y(); y <= last.y(); ++y) {
+      for (int64_t z = first.z(); z <= last.z(); ++z) {
+        const voxblox::LongIndex index(x, y, z);
+        const Eigen::Vector3d voxel_center =
+            voxblox::getCenterPointFromGridIndex(index, voxel_size)
+                .cast<double>();
+        const double fraction = segment_sq > 1e-12
+            ? std::max(0.0, std::min(1.0,
+                (voxel_center - start).dot(segment) / segment_sq))
+            : 0.0;
+        const Eigen::Vector3d nearest = start + fraction * segment;
+        if ((voxel_center - nearest).squaredNorm() > expanded_radius_sq)
+          continue;
+        const SDFVoxelType* voxel =
+            sdf_layer_->getVoxelPtrByGlobalIndex(index);
+        if (checkUnknownStatus(voxel)) {
+          if (stop_at_unknown_voxel) return VoxelStatus::kUnknown;
+          status = VoxelStatus::kUnknown;
+        } else if (voxel->distance <= occupancy_distance) {
+          return VoxelStatus::kOccupied;
+        }
+      }
+    }
+  }
+  return status;
+}
