+TEST(YawRateLimit, LocalTrackingDoesNotFreezeYawAfterSharpTurn) {
+    const auto position = makeRightAnglePositionTrajectory();
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    requested(0) = M_PI_2;
+    geometry_utils::Trajectory yaw;
+    traj_opt::YawTrajOpt optimizer(0.6, 0.2, true);
+    ASSERT_TRUE(optimizer.optimize(initial, requested, position, yaw,
+                                   3, false, true));
+    EXPECT_LE(yaw.getMaxVelRate(), 0.6001);
+    EXPECT_GT(yaw.getPos(3.0).x(), 0.4);
+    EXPECT_GT(yaw.getPos(4.0).x(), 0.9);
+    for (int i = 1; i < yaw.getPieceNum(); ++i) {
+        const auto& before = yaw[i - 1];
+        const auto& after = yaw[i];
+        EXPECT_NEAR(before.getPos(before.getDuration()).x(),
+                    after.getPos(0.0).x(), 1e-7);
+        EXPECT_NEAR(before.getVel(before.getDuration()).x(),
+                    after.getVel(0.0).x(), 1e-7);
+    }
+}
+
+TEST(YawRateLimit, LocalTrackingAcceptsSmoothForwardTurn) {
+    const auto position = makeSmoothQuarterTurnTrajectory();
+    super_utils::Vec4f initial = super_utils::Vec4f::Zero();
+    super_utils::Vec4f requested = super_utils::Vec4f::Zero();
+    geometry_utils::Trajectory yaw;
+    traj_opt::YawTrajOpt optimizer(0.6, 0.2, true);
+    ASSERT_TRUE(optimizer.optimize(initial, requested, position, yaw,
+                                   3, false, true));
+    EXPECT_LE(yaw.getMaxVelRate(), 0.6001);
+    // A smooth turn remains a valid trajectory; yaw follows within the
+    // optimizer's physical turn-rate limit without rejecting the route.
+    EXPECT_GT(yaw.getPos(4.0).x(), 1.0);
+}
