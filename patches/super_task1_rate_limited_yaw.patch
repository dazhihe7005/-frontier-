+geometry_utils::Trajectory makeSmoothQuarterTurnTrajectory() {
+    geometry_utils::Trajectory position;
+    constexpr int kPieces = 16;
+    constexpr double kDuration = 0.25;
+    constexpr double kRadius = 2.0;
+    for (int i = 0; i < kPieces; ++i) {
+        const double angle0 = M_PI_2 * i / kPieces;
+        const double angle1 = M_PI_2 * (i + 1) / kPieces;
+        Eigen::MatrixXd coefficients = Eigen::MatrixXd::Zero(3, 2);
+        coefficients(0, 0) = kRadius *
+            (std::sin(angle1) - std::sin(angle0)) / kDuration;
+        coefficients(1, 0) = kRadius *
+            (std::cos(angle0) - std::cos(angle1)) / kDuration;
+        coefficients(0, 1) = kRadius * std::sin(angle0);
+        coefficients(1, 1) = kRadius * (1.0 - std::cos(angle0));
+        position.emplace_back(kDuration, coefficients);
+    }
+    return position;
+}
+
