+    bool SuperPlanner::canRetargetCurrentTrajectory(double min_remaining) const {
+        const auto snapshot = cmd_traj_info_.heartbeatSnapshot();
+        const double elapsed = ros_ptr_->getSimTime() - snapshot.start_wall_time;
+        if (!std::isfinite(elapsed) || elapsed < 0.0 ||
+            snapshot.total_duration - elapsed <= min_remaining ||
+            robot_on_backup_traj_) return false;
+        // Do not carry a trajectory into its emergency backup segment.
+        return !snapshot.backup_available ||
+               snapshot.backup_start_time - elapsed > min_remaining;
+    }
