diff --git a/rog_map/include/rog_map/rog_map_core/inflation_geometry.h b/rog_map/include/rog_map/rog_map_core/inflation_geometry.h
new file mode 100644
--- /dev/null
+++ b/rog_map/include/rog_map/rog_map_core/inflation_geometry.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <cstdlib>
+
+namespace rog_map {
+
+// A negative vertical step preserves the upstream spherical inflation.
+// An explicit vertical step uses a horizontal disk extruded only through
+// the vehicle's vertical body height; it does not turn floor stand-off into
+// a horizontal wall stand-off.
+inline bool includeInflationOffset(int dx, int dy, int dz,
+                                   int horizontal_step, int vertical_step) {
+    if (vertical_step < 0) {
+        return horizontal_step == 1 ||
+               dx * dx + dy * dy + dz * dz <= horizontal_step * horizontal_step;
+    }
+    return dx * dx + dy * dy <= horizontal_step * horizontal_step &&
+           std::abs(dz) <= vertical_step;
+}
+
+}  // namespace rog_map
diff --git a/rog_map/test/inflation_geometry_test.cpp b/rog_map/test/inflation_geometry_test.cpp
new file mode 100644
--- /dev/null
+++ b/rog_map/test/inflation_geometry_test.cpp
@@ -0,0 +1,13 @@
+#include <gtest/gtest.h>
+#include <rog_map/rog_map_core/inflation_geometry.h>
+
+TEST(InflationGeometry, DefaultPreservesSphere) {
+    EXPECT_TRUE(rog_map::includeInflationOffset(2, 2, 1, 3, -1));
+    EXPECT_FALSE(rog_map::includeInflationOffset(3, 3, 0, 3, -1));
+}
+
+TEST(InflationGeometry, ExplicitVerticalExtentKeepsWallAndExcludesFarFloor) {
+    EXPECT_TRUE(rog_map::includeInflationOffset(7, 0, 2, 7, 2));
+    EXPECT_FALSE(rog_map::includeInflationOffset(7, 0, 3, 7, 2));
+    EXPECT_FALSE(rog_map::includeInflationOffset(6, 6, 0, 7, 2));
+}
